# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/indiecrowdfund?schema=public"

# NextAuth
AUTH_SECRET="your-auth-secret-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Wise Platform API
# Get your credentials at: https://wise.com/gb/business/platform
WISE_API_TOKEN="your-wise-api-token"
WISE_PROFILE_ID="your-wise-profile-id"
WISE_CLIENT_ID="your-wise-client-id"
WISE_CLIENT_SECRET="your-wise-client-secret"
WISE_WEBHOOK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_WISE_WEBHOOK_PUBLIC_KEY\n-----END PUBLIC KEY-----"
WISE_ENVIRONMENT="sandbox"  # sandbox or production

# Wise API URLs (set automatically based on WISE_ENVIRONMENT)
# Sandbox: https://api.sandbox.transferwise.tech
# Production: https://api.wise.com

# Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@yourdomain.com"

# Redis (Upstash)
UPSTASH_REDIS_URL="https://..."
UPSTASH_REDIS_TOKEN="..."

# File Upload (UploadThing)
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_APP_ID="..."

# Cron Jobs
CRON_SECRET="your-cron-secret"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="IndieCrowdfund"
