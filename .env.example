# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/indiecrowdfund?schema=public"

# NextAuth
AUTH_SECRET="your-auth-secret-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Security Secrets (required in production)
# Generate with: openssl rand -base64 32
RETAILER_JWT_SECRET="your-retailer-jwt-secret-generate-with-openssl"
# UNSUBSCRIBE_SECRET is optional - falls back to AUTH_SECRET if not set
# UNSUBSCRIBE_SECRET="your-unsubscribe-secret"
# Bank account encryption - REQUIRED for saving bank account details
BANK_ACCOUNT_ENCRYPTION_KEY="your-encryption-key-generate-with-openssl-rand-base64-32"

# Stripe
# Get your credentials at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@yourdomain.com"

# Redis (Upstash)
UPSTASH_REDIS_URL="https://..."
UPSTASH_REDIS_TOKEN="..."

# File Upload (UploadThing)
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_APP_ID="..."

# Cron Jobs
CRON_SECRET="your-cron-secret"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="IndieCrowdfund"

# Redis Rate Limiting (Upstash - for multi-instance scaling)
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# Structured Logging
# LOG_LEVEL: trace, debug, info, warn, error, fatal (default: "info" in production, "debug" in dev)
LOG_LEVEL="info"

# Prometheus Metrics
# Set a token to protect the /api/metrics endpoint
METRICS_TOKEN="your-metrics-bearer-token"

# Vault / Secret Management
# VAULT_PROVIDER: "local" (default), "aws-kms", "hashicorp"
# VAULT_PROVIDER="local"
# For AWS KMS: AWS_KMS_KEY_ID="arn:aws:kms:..."
# For HashiCorp Vault: VAULT_ADDR="https://vault.example.com", VAULT_TOKEN="..."
# Credentials encryption key (for vault-backed secrets in database)
CREDENTIALS_ENCRYPTION_KEY="your-credentials-key-generate-with-openssl-rand-base64-32"
