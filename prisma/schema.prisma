  borderRadius          String   @default("8")

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ============================================
// MODERATION & REPORTS
// ============================================

model Report {
  id            String       @id @default(cuid())
  reporterId    String?
  reporterEmail String?

  // What is being reported
  targetType    ReportTarget
  targetId      String
  projectId     String?
  userId        String?

  // Report details
  reason        ReportReason
  description   String       @db.Text
  evidence      String[]

  // Status
  status        ReportStatus @default(PENDING)
  priority      ReportPriority @default(MEDIUM)

  // Resolution
  resolvedBy    String?
  resolvedAt    DateTime?
  resolution    String?      @db.Text
  actionTaken   ReportAction?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, priority])
  @@index([targetType, targetId])
  @@index([projectId])
  @@index([userId])
}

enum ReportTarget {
  PROJECT
  USER
  COMMENT
  MESSAGE
  UPDATE
  REWARD
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  FRAUD
  COPYRIGHT
  INAPPROPRIATE_CONTENT
  MISLEADING
  IMPERSONATION
  OTHER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
  ESCALATED
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ReportAction {
  WARNING_ISSUED
  CONTENT_REMOVED
  USER_SUSPENDED
  USER_BANNED
  PROJECT_SUSPENDED
  PROJECT_REMOVED
  NO_ACTION
}

// ============================================
// MEDIA LIBRARY
// ============================================

model MediaFile {
  id            String     @id @default(cuid())
  uploaderId    String?

  filename      String
  originalName  String
  mimeType      String
  size          Int
  url           String
  thumbnailUrl  String?

  // Metadata
  width         Int?
  height        Int?
  duration      Int?

  // Organization
  folder        String     @default("uploads")
  tags          String[]
  altText       String?

  // Usage tracking
  usageCount    Int        @default(0)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([uploaderId])
  @@index([folder])
  @@index([mimeType])
}

// ============================================
// PAGE BUILDER
// ============================================

model CustomPage {
  id            String     @id @default(cuid())
  slug          String     @unique
  title         String
  description   String?

  // Page content (JSON structure)
  content       Json

  // SEO
  metaTitle     String?
  metaDescription String?
  ogImage       String?

  // Status
  isPublished   Boolean    @default(false)
  publishedAt   DateTime?

  createdBy     String?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([slug])
  @@index([isPublished])
}

// ============================================
// EMAIL TEMPLATES & CAMPAIGNS
// ============================================

model EmailTemplate {
  id            String     @id @default(cuid())
  name          String     @unique
  subject       String
  htmlContent   String     @db.Text
  textContent   String?    @db.Text

  // Variables that can be used
  variables     String[]

  isActive      Boolean    @default(true)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model EmailCampaign {
  id            String           @id @default(cuid())
  name          String
  subject       String
  htmlContent   String           @db.Text

  // Targeting
  targetAudience String          @default("all")
  filters       Json?

  // Status
  status        CampaignStatus   @default(DRAFT)
  scheduledFor  DateTime?
  sentAt        DateTime?

  // Stats
  recipientCount Int             @default(0)
  sentCount     Int              @default(0)
  openCount     Int              @default(0)
  clickCount    Int              @default(0)
  bounceCount   Int              @default(0)
  unsubscribeCount Int           @default(0)

  createdBy     String?

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

// ============================================
// MAILBOX MANAGEMENT
// ============================================

model Mailbox {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  description   String?
  color         String?       @default("#3B82F6")

  // IMAP/SMTP settings for external mailboxes (optional)
  imapHost      String?
  imapPort      Int?
  smtpHost      String?
  smtpPort      Int?
  username      String?
  password      String?       // Encrypted
  useSSL        Boolean       @default(true)

  isDefault     Boolean       @default(false)
  isActive      Boolean       @default(true)

  emails        AdminEmail[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([isActive])
}

model AdminEmail {
  id            String           @id @default(cuid())
  mailboxId     String

  // Email details
  fromEmail     String
  fromName      String?
  toEmail       String
  toName        String?
  ccEmails      String[]
  bccEmails     String[]
  replyTo       String?
  subject       String
  bodyHtml      String           @db.Text
  bodyText      String?          @db.Text

  // Folder/status
  folder        EmailFolder      @default(INBOX)
  status        AdminEmailStatus @default(PENDING)

  // Tracking
  isRead        Boolean          @default(false)
  isStarred     Boolean          @default(false)
  isArchived    Boolean          @default(false)

  // Dates
  sentAt        DateTime?
  receivedAt    DateTime?
  openedAt      DateTime?

  // Thread support
  threadId      String?
  inReplyTo     String?

  // Attachments stored as JSON array
  attachments   Json?

  mailbox       Mailbox          @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([mailboxId, folder])
  @@index([mailboxId, status])
  @@index([mailboxId, isRead])
  @@index([threadId])
}

enum EmailFolder {
  INBOX
  SENT
  DRAFTS
  TRASH
  SPAM
  ARCHIVE
}

enum AdminEmailStatus {
  PENDING
  SENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

// ============================================
// ID VERIFICATION
// ============================================

model IDVerification {
  id                String                 @id @default(cuid())
  userId            String

  // Shufti Reference
  shuftiReference   String                 @unique
  verificationUrl   String?

  // Verification Status
  status            IDVerificationStatus   @default(PENDING)

  // Results
  isDocumentValid   Boolean?
  isFaceMatch       Boolean?
  isAgeVerified     Boolean?
  detectedAge       Int?
  documentType      String?
  documentCountry   String?

  // Decline info
  declineReason     String?
  declineCodes      String[]

  // Raw response (for debugging)
  rawResponse       Json?

  // Timestamps
  requestedAt       DateTime              @default(now())
  completedAt       DateTime?
  expiresAt         DateTime?

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([shuftiReference])
  @@index([status])
}

enum IDVerificationStatus {
  PENDING
  PROCESSING
  VERIFIED
  DECLINED
  EXPIRED
  CANCELLED
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id          String             @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  message     String
  read        Boolean            @default(false)
  actionUrl   String?

  // Related entities (optional)
  projectId   String?
  senderId    String?            // For collaborator invites, this would be the project creator

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime           @default(now())
  readAt      DateTime?

  @@index([userId, read])
  @@index([userId, createdAt])
}

enum NotificationType {
  COLLABORATOR_INVITE
  COLLABORATOR_ACCEPTED
  COLLABORATOR_DECLINED
  PROJECT_UPDATE
  PROJECT_FUNDED
  PROJECT_LAUNCHED
  PLEDGE_RECEIVED
  PLEDGE_FAILED
  COMMENT_REPLY
  MESSAGE_RECEIVED
  SYSTEM
}
