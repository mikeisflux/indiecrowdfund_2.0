model RetailerPledge {
  id                    String              @id @default(cuid())
  retailerId            String
  projectId             String
  rewardId              String

  // Order Details
  quantity              Int
  unitPrice             Float
  discountPercent       Float
  totalAmount           Float
  originalAmount        Float

