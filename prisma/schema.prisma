  retailer              Retailer            @relation(fields: [retailerId], references: [id])
  project               Project             @relation(fields: [projectId], references: [id])

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  paidAt                DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?

  @@index([retailerId])
  @@index([projectId])
  @@index([status])
}

enum RetailerType {
