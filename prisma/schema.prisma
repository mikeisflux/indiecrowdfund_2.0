  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum RetailerPledgeStatus {
  PENDING
  INVOICED
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

