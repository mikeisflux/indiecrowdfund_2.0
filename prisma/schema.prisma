generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER MANAGEMENT
// ============================================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  emailVerified     DateTime?
  name              String?
  image             String?
  password          String?
  bio               String?   @db.Text
  location          String?
  timezone          String?
  vanityUrl         String?   @unique
  websites          String[]
  showNameOnly      Boolean   @default(false)
  role              UserRole  @default(USER)
  retailerAccess    Boolean   @default(false)
  stripeCustomerId  String?   @unique  // Stripe Customer ID for payment methods

  // ID Verification
  idVerified        Boolean   @default(false)
  idVerifiedAt      DateTime?
  idVerificationId  String?   // Shufti reference ID
  dateOfBirth       DateTime?

  // Auth
  accounts          Account[]
  sessions          Session[]

  // Relations
  createdProjects   Project[] @relation("ProjectCreator")
  collaborations    ProjectCollaborator[]
  pledges           Pledge[]
  sentMessages      Message[] @relation("MessageSender")
  receivedMessages  Message[] @relation("MessageRecipient")
  comments          Comment[]
  behaviors         UserBehavior[]
  preferences       UserPreference?
  interestProfile   UserInterestProfile?
  emailLogs         EmailLog[]
  stripeConfig      StripeConfig?
  idVerifications   IDVerification[]
  notifications     Notification[]
  bugReports        BugReport[]
  mediaFiles        MediaFile[]
  apiKeys           ApiKey[]
  backerNotes       BackerNote[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([email])
  @@index([vanityUrl])
}

enum UserRole {
  USER
  COOL_KIDS
  ADMIN
  SUPER_ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

// ============================================
// PROJECT MANAGEMENT
// ============================================

model Project {
  id                    String        @id @default(cuid())
  creatorId             String

  // Basics
  title                 String
  subtitle              String?
  slug                  String        @unique
  category              String
  subcategory           String?
  secondaryCategory     String?
  secondarySubcategory  String?
  location              String?
  imageUrl              String?
  videoUrl              String?
  goalAmount            Float
  currency              String        @default("USD")

  // Duration
  durationType          DurationType
  durationDays          Int?
  endDate               DateTime?
  launchDate            DateTime?

  // Story
  description           String        @db.Text
  risks                 String        @db.Text
  usesAI                Boolean       @default(false)
  faqs                  Json?

  // Payment
  contactEmail          String
  projectType           ProjectType
  paymentProcessor      PaymentProcessor @default(STRIPE)
  hasAdultContent       Boolean       @default(false)
  hasRiskyContent       Boolean       @default(false)
  promoContentSfw       Boolean       @default(true)  // Agrees promotional materials (video, image, title) are SFW
  bankAccountId         String?

  // Stripe
  stripeAccountId       String?

  // Promotion
  prelaunchActive       Boolean         @default(false)
  prelaunchStatus       PrelaunchStatus @default(DRAFT)
  prelaunchDescription  String?         @db.Text
  customReferralTags    String[]
  googleAnalyticsId     String?
  googleAnalyticsSecret String?
  metaPixelId           String?
  metaConversionsToken  String?

  // Retailer Settings
  allowRetailerPledges  Boolean       @default(false)
  retailerDiscount      Float         @default(50)
  retailerMinQuantity   Int           @default(1)
  retailerMaxQuantity   Int?

  // Status
  status                ProjectStatus @default(DRAFT)
  currentAmount         Float         @default(0)
  backerCount           Int           @default(0)
  followerCount         Int           @default(0)
  isStaffPick           Boolean       @default(false)

  // AI-generated tags for matching
  tags                  String[]

  // Relations
  creator               User          @relation("ProjectCreator", fields: [creatorId], references: [id])
  projectItems          ProjectItem[]
  rewards               Reward[]
  pledges               Pledge[]
  updates               Update[]
  collaborators         ProjectCollaborator[]
  messages              Message[]
  analytics             AnalyticsEvent[]
  comments              Comment[]
  payouts               Payout[]
  behaviors             UserBehavior[]
  emailLogs             EmailLog[]
  projectSimilarities   ProjectSimilarity[] @relation("ProjectSimilarities")
  similarProjects       ProjectSimilarity[] @relation("SimilarProjects")
  followers             ProjectFollower[]
  retailerPledges       RetailerPledge[]

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  launchedAt            DateTime?
  fundedAt              DateTime?

  @@index([creatorId])
  @@index([status])
  @@index([category])
  @@index([slug])
}

model ProjectFollower {
  id          String   @id @default(cuid())
  projectId   String
  userId      String?
  email       String?
  isPrelaunch Boolean  @default(false)

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([projectId, userId])
  @@unique([projectId, email])
  @@index([projectId])
}

enum DurationType {
  FIXED_DAYS
  END_DATE
}

enum ProjectType {
  INDIVIDUAL
  BUSINESS
  NONPROFIT
}

enum ProjectStatus {
  DRAFT
  SUBMITTED
  APPROVED
  LIVE
  PAUSED
  FUNDED
  FAILED
  CANCELLED
}

enum PrelaunchStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum PaymentProcessor {
  STRIPE
}

// ============================================
// PROJECT ITEMS (independent of rewards)
// ============================================

model ProjectItem {
  id          String  @id @default(cuid())
  projectId   String
  title       String
  description String? @db.Text
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rewardItems RewardItem[]

  @@index([projectId])
}

// ============================================
// REWARDS & ADD-ONS
// ============================================

model Reward {
  id                String       @id @default(cuid())
  projectId         String
  type              RewardType   @default(TIER)

  title             String
  description       String       @db.Text
  amount            Float
  imageUrl          String?

  // Delivery
  estimatedDelivery DateTime?
  shippingType      ShippingType
  shippingCountries String[]
  shippingCost      Json         @default("{}")  // Per-country rates: { "US": 5, "CA": 8 }

  // Availability
  quantityAvailable Int?
  quantityClaimed   Int          @default(0)
  visibility        Visibility   @default(PUBLIC)
  secretToken       String?      @unique  // For secret rewards - only accessible via this token
  availableFrom     DateTime?
  availableUntil    DateTime?

  // Status - for ending rewards that have backers
  isEnded           Boolean      @default(false)
  endedAt           DateTime?

  // Tracking if copied
  copiedFromId      String?

  // Relations
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pledges           Pledge[]
  items             RewardItem[]
  copiedFrom        Reward?      @relation("RewardCopies", fields: [copiedFromId], references: [id])
  copies            Reward[]     @relation("RewardCopies")
  selectedAddons    PledgeAddon[]

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([projectId, type])
}

enum RewardType {
  TIER
  ADDON
}

enum ShippingType {
  WORLDWIDE
  SELECTED_COUNTRIES
  NO_SHIPPING
}

enum Visibility {
  PUBLIC
  SECRET
}

model RewardItem {
  id            String  @id @default(cuid())
  rewardId      String
  projectItemId String?  // Optional reference to project-level item
  title         String
  description   String? @db.Text
  imageUrl      String?

  reward        Reward       @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  projectItem   ProjectItem? @relation(fields: [projectItemId], references: [id])

  @@index([rewardId])
  @@index([projectItemId])
}

// ============================================
// PLEDGES & PAYMENTS
// ============================================

model Pledge {
  id                    String       @id @default(cuid())
  userId                String
  projectId             String
  rewardId              String?      // Optional - null for "pledge without reward"

  // Backer number - order in which they backed this project (assigned on successful payment)
  backerNumber          Int?

  // Amounts
  amount                Float
  rewardAmount          Float
  addonsAmount          Float        @default(0)
  shippingAmount        Float        @default(0)

  // Payment
  status                PledgeStatus
  paymentProcessor      PaymentProcessor

  // Stripe fields
  stripePaymentIntentId String?      @unique
  stripeSetupIntentId   String?      @unique
  stripePaymentMethodId String?
  stripeCustomerId      String?

  // Payment retry tracking
  retryCount            Int          @default(0)
  nextRetryAt           DateTime?
  lastFailureReason     String?
  chargedImmediately    Boolean      @default(false)  // True if campaign was already funded when pledge was made

  // Survey
  surveyCompleted       Boolean      @default(false)
  shippingAddress       Json?
  surveyResponses       Json?

  // Fulfillment
  fulfillmentStatus     FulfillmentStatus @default(NOT_STARTED)

  // Email tracking
  confirmationEmailSent Boolean      @default(false)

  // Relations
  user                  User         @relation(fields: [userId], references: [id])
  project               Project      @relation(fields: [projectId], references: [id])
  reward                Reward?      @relation(fields: [rewardId], references: [id])
  addons                PledgeAddon[]
  emailLogs             EmailLog[]

  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([projectId, status])
  @@index([userId])
  @@index([rewardId])
  @@index([status, nextRetryAt])  // For retry job queries
}

model PledgeAddon {
  id        String @id @default(cuid())
  pledgeId  String
  addonId   String
  quantity  Int    @default(1)
  amount    Float

  pledge    Pledge @relation(fields: [pledgeId], references: [id], onDelete: Cascade)
  addon     Reward @relation(fields: [addonId], references: [id])

  @@unique([pledgeId, addonId])
  @@index([pledgeId])
}

enum PledgeStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
  CHARGEBACK
}

enum FulfillmentStatus {
  NOT_STARTED
  IN_PROGRESS
  SHIPPED
  DELIVERED
}

// ============================================
// PAYOUTS
// ============================================

model Payout {
  id                String       @id @default(cuid())
  projectId         String
  amount            Float
  grossAmount       Float
  processorFees     Float
  platformFees      Float
  type              PayoutType
  status            PayoutStatus
  payoutId          String?      @unique
  bankAccountLast4  String?

  project           Project      @relation(fields: [projectId], references: [id])

  sentAt            DateTime?
  createdAt         DateTime     @default(now())

  @@index([projectId])
}

enum PayoutType {
  CAMPAIGN
  LATE_PLEDGE
  PLEDGE_MANAGER
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================
// COLLABORATORS
// ============================================

model ProjectCollaborator {
  id                        String             @id @default(cuid())
  projectId                 String
  userId                    String?            // Optional - linked when user accepts invite
  email                     String             // Required - used to identify the collaborator
  title                     String?

  // Permissions
  canEditProject            Boolean            @default(false)
  canManageCommunity        Boolean            @default(false)
  canCoordinateFulfillment  Boolean            @default(false)
  canConfigurePledgeManager Boolean            @default(false)

  status                    CollaboratorStatus @default(PENDING)

  project                   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                      User?              @relation(fields: [userId], references: [id])

  invitedAt                 DateTime           @default(now())
  acceptedAt                DateTime?

  @@unique([projectId, email])
  @@index([projectId])
  @@index([userId])
  @@index([email])
}

enum CollaboratorStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// ============================================
// UPDATES
// ============================================

model Update {
  id          String           @id @default(cuid())
  projectId   String
  title       String
  content     String           @db.Text
  visibility  UpdateVisibility @default(PUBLIC)
  status      UpdateStatus     @default(DRAFT)

  likes       Int              @default(0)
  commentsCount Int            @default(0)

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments    Comment[]

  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([projectId, status])
}

enum UpdateVisibility {
  PUBLIC
  BACKERS_ONLY
}

enum UpdateStatus {
  DRAFT
  PUBLISHED
}

// ============================================
// COMMENTS
// ============================================

model Comment {
  id          String   @id @default(cuid())
  projectId   String?
  updateId    String?
  userId      String
  content     String   @db.Text
  parentId    String?  // For creator replies

  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  update      Update?  @relation(fields: [updateId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])
  parent      Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[] @relation("CommentReplies")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([updateId])
  @@index([userId])
  @@index([parentId])
}

// ============================================
// MESSAGES
// ============================================

model Message {
  id              String   @id @default(cuid())
  projectId       String
  senderId        String
  recipientId     String
  subject         String?
  content         String   @db.Text
  read            Boolean  @default(false)
  isSpam          Boolean  @default(false)

  project         Project  @relation(fields: [projectId], references: [id])
  sender          User     @relation("MessageSender", fields: [senderId], references: [id])
  recipient       User     @relation("MessageRecipient", fields: [recipientId], references: [id])

  createdAt       DateTime @default(now())
  readAt          DateTime?

  @@index([projectId, recipientId])
  @@index([senderId])
  @@index([recipientId])
}

// ============================================
// ANALYTICS
// ============================================

model AnalyticsEvent {
  id          String    @id @default(cuid())
  projectId   String
  eventType   EventType

  // Attribution
  referrer    String?
  channel     String?
  customTag   String?

  // Data
  amount      Float?
  userId      String?
  metadata    Json?

  project     Project   @relation(fields: [projectId], references: [id])

  timestamp   DateTime  @default(now())

  @@index([projectId, eventType, timestamp])
  @@index([projectId, referrer])
}

enum EventType {
  PAGE_VIEW
  PROJECT_FOLLOW
  VIDEO_PLAY
  VIDEO_COMPLETE
  PLEDGE_STARTED
  PLEDGE_COMPLETED
  PLEDGE_FAILED
  REWARD_SELECTED
  ADDON_SELECTED
  SHARE
}

// ============================================
// PAYMENT PROCESSOR CONFIGURATION
// ============================================

model StripeConfig {
  id              String   @id @default(cuid())
  userId          String   @unique
  stripeAccountId String   @unique
  isOnboarded     Boolean  @default(false)
  isActive        Boolean  @default(true)

  user            User     @relation(fields: [userId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

// ============================================
// RECOMMENDATION ENGINE & BEHAVIORAL TRACKING
// ============================================

model UserBehavior {
  id          String            @id @default(cuid())
  userId      String?
  sessionId   String
  eventType   BehaviorEventType

  // Event data
  projectId   String?
  categoryId  String?
  rewardId    String?
  searchQuery String?

  // Context
  path        String
  referrer    String?
  userAgent   String?
  ipAddress   String?
  country     String?

  // Engagement metrics
  timeSpent   Int?
  scrollDepth Float?

  metadata    Json?

  timestamp   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
  project     Project? @relation(fields: [projectId], references: [id])

  @@index([userId, eventType, timestamp])
  @@index([sessionId, timestamp])
  @@index([projectId, eventType])
  @@index([categoryId, timestamp])
}

enum BehaviorEventType {
  PAGE_VIEW
  PAGE_EXIT
  PROJECT_VIEW
  PROJECT_CLICK
  REWARD_CLICK
  VIDEO_PLAY
  VIDEO_COMPLETE
  SEARCH
  FILTER_APPLY
  PROJECT_SAVE
  PROJECT_SHARE
  COMMENT_POST
  PLEDGE_START
  PLEDGE_COMPLETE
  SCROLL_DEPTH
  HOVER
  CREATOR_VIEW
}

// User interest profile for AI-powered email matching
model UserInterestProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Category interests (weighted by engagement)
  categoryInterests Json     // { "TECHNOLOGY": 0.85, "GAMES": 0.72, ... }

  // Tag interests from viewed/backed projects
  tagInterests      Json     // { "indie": 0.9, "puzzle": 0.65, ... }

  // Search-based interests
  searchInterests   String[] // Keywords from search queries

  // Engagement metrics
  totalProjectsViewed    Int     @default(0)
  totalProjectsBacked    Int     @default(0)
  avgPledgeAmount        Float   @default(0)

  // Preferred project attributes
  preferredGoalRange     Json?   // { "min": 1000, "max": 50000 }
  preferredDuration      Int?    // Preferred campaign duration in days

  // Time preferences (for send time optimization)
  activeHours            Int[]   // Hours when user is most active (0-23)
  activeDays             Int[]   // Days when user is most active (0-6, 0=Sunday)

  // Profile quality score (based on data available)
  profileScore           Float   @default(0) // 0-100

  // Last calculation timestamp
  lastCalculatedAt       DateTime @default(now())

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([profileScore])
  @@index([lastCalculatedAt])
}

model UserPreference {
  id              String   @id @default(cuid())
  userId          String   @unique

  // Category preferences (weighted scores 0-1)
  categoryScores  Json

  // Preferred pledge ranges
  minPledge       Float?
  maxPledge       Float?
  avgPledge       Float?

  // Creator preferences
  followedCreators String[]
  backedCreators   String[]

  // Content preferences
  prefersVideo     Boolean  @default(true)
  prefersLongForm  Boolean  @default(true)

  // Geographic preferences
  prefersLocal     Boolean  @default(false)
  preferredCountries String[]

  // Engagement level (0-100)
  engagementScore  Int      @default(50)

  // Email preferences
  emailPreferences Json?

  // Last calculated
  lastUpdated      DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ProjectSimilarity {
  id               String   @id @default(cuid())
  projectId        String
  similarProjectId String
  similarityScore  Float
  reason           String

  project          Project  @relation("ProjectSimilarities", fields: [projectId], references: [id])
  similarProject   Project  @relation("SimilarProjects", fields: [similarProjectId], references: [id])

  createdAt        DateTime @default(now())

  @@unique([projectId, similarProjectId])
  @@index([projectId, similarityScore])
}

model EmailLog {
  id             String    @id @default(cuid())
  userId         String?
  projectId      String?
  pledgeId       String?
  type           EmailType
  subject        String?
  recipientEmail String    // Store recipient email in case user email changes
  htmlContent    String?   @db.Text  // Store the full HTML content for viewing/downloading

  sentAt         DateTime  @default(now())
  openedAt       DateTime?
  clickedAt      DateTime?

  user           User?     @relation(fields: [userId], references: [id])
  project        Project?  @relation(fields: [projectId], references: [id])
  pledge         Pledge?   @relation(fields: [pledgeId], references: [id])

  @@index([userId, type, sentAt])
  @@index([projectId, type])
  @@index([pledgeId])
  @@index([recipientEmail])
}

enum EmailType {
  WEEKLY_DISCOVERY
  CREATOR_LAUNCH
  CATEGORY_ALERT
  ENDING_SOON
  PROJECT_FUNDED
  FUNDING_MILESTONE
  UPDATE_NOTIFICATION
  SURVEY_REMINDER
  PLEDGE_CONFIRMATION
  WELCOME
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

// ============================================
// NEWSLETTER SUBSCRIBERS
// ============================================

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  source       String?  // csv_import, website_signup, etc.
  isActive     Boolean  @default(true)
  subscribedAt DateTime @default(now())
  unsubscribedAt DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([isActive])
  @@index([source])
}

// ============================================
// BACKER SURVEYS
// ============================================

model Survey {
  id                String           @id @default(cuid())
  projectId         String           @unique

  // Survey intro
  introTitle        String?
  introMessage      String?          @db.Text

  // Status
  status            SurveyStatus     @default(DRAFT)
  sentAt            DateTime?
  lockedAt          DateTime?

  // Address settings
  collectAddresses  Boolean          @default(true)
  addressesLocked   Boolean          @default(false)

  // Relations
  itemQuestions     SurveyItemQuestion[]
  backerQuestions   SurveyBackerQuestion[]
  responses         SurveyResponse[]

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([projectId])
  @@index([status])
}

enum SurveyStatus {
  DRAFT
  SENT
  LOCKED
}

// Item questions - for reward-specific variants (size, color, etc.)
model SurveyItemQuestion {
  id              String               @id @default(cuid())
  surveyId        String
  rewardId        String               // Which reward this applies to

  // Item details
  itemName        String               // e.g., "T-Shirt", "Art Print"
  itemDescription String?              @db.Text
  imageUrl        String?

  // Question ordering
  sortOrder       Int                  @default(0)

  // Relations
  survey          Survey               @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  variants        SurveyItemVariant[]
  customQuestions SurveyItemCustomQuestion[]

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([surveyId])
  @@index([rewardId])
}

// Variant options for items (e.g., Size: S/M/L/XL, Color: Red/Blue/Green)
model SurveyItemVariant {
  id              String             @id @default(cuid())
  itemQuestionId  String

  variantType     String             // e.g., "Size", "Color", "Style"
  options         String[]           // e.g., ["S", "M", "L", "XL"]

  // Auto-generated SKU prefix
  skuPrefix       String?

  sortOrder       Int                @default(0)

  itemQuestion    SurveyItemQuestion @relation(fields: [itemQuestionId], references: [id], onDelete: Cascade)

  createdAt       DateTime           @default(now())

  @@index([itemQuestionId])
}

// Custom questions for specific items (beyond variants)
model SurveyItemCustomQuestion {
  id              String             @id @default(cuid())
  itemQuestionId  String

  question        String
  description     String?
  questionType    SurveyQuestionType @default(OPEN_TEXT)
  options         String[]           // For multiple/single selection
  isRequired      Boolean            @default(false)

  sortOrder       Int                @default(0)

  itemQuestion    SurveyItemQuestion @relation(fields: [itemQuestionId], references: [id], onDelete: Cascade)

  createdAt       DateTime           @default(now())

  @@index([itemQuestionId])
}

// Backer questions - general questions for all or specific backers
model SurveyBackerQuestion {
  id              String             @id @default(cuid())
  surveyId        String

  question        String
  description     String?            @db.Text
  questionType    SurveyQuestionType @default(OPEN_TEXT)
  options         String[]           // For multiple/single selection

  // Targeting
  targetType      SurveyTargetType   @default(ALL_BACKERS)
  targetRewardIds String[]           // If targeting specific rewards

  isRequired      Boolean            @default(false)
  sortOrder       Int                @default(0)

  survey          Survey             @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([surveyId])
}

enum SurveyQuestionType {
  OPEN_TEXT
  SINGLE_SELECT
  MULTIPLE_SELECT
}

enum SurveyTargetType {
  ALL_BACKERS
  SPECIFIC_REWARDS
}

model SurveyResponse {
  id              String   @id @default(cuid())
  surveyId        String
  pledgeId        String   @unique

  // Item responses (variant selections + custom question answers)
  itemResponses   Json?    // { itemQuestionId: { variants: { variantType: selectedOption }, customAnswers: { questionId: answer } } }

  // Backer question responses
  backerResponses Json?    // { questionId: answer }

  // Shipping address
  shippingAddress Json?    // { name, line1, line2, city, state, postalCode, country, phone }
  addressLocked   Boolean  @default(false)

  // Status
  isComplete      Boolean  @default(false)
  completedAt     DateTime?

  survey          Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([surveyId])
  @@index([isComplete])
}

// ============================================
// PROJECT VIEWS & REFERRAL TRACKING
// ============================================

model ProjectView {
  id          String   @id @default(cuid())
  projectId   String
  date        DateTime @db.Date
  views       Int      @default(0)
  uniqueViews Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, date])
  @@index([projectId, date])
}

model ReferralTracker {
  id           String   @id @default(cuid())
  projectId    String
  referrer     String
  referrerType String
  tag          String?
  date         DateTime @db.Date
  visits       Int      @default(0)
  pledges      Int      @default(0)
  pledgeAmount Float    @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([projectId, referrer, date])
  @@index([projectId, date])
  @@index([projectId, referrerType])
}

// ============================================
// PROJECT REVIEW & APPROVAL
// ============================================

model ProjectReview {
  id              String              @id @default(cuid())
  projectId       String
  reviewerId      String?
  reviewerEmail   String?

  // Review action
  action          ReviewAction
  previousStatus  ProjectStatus
  newStatus       ProjectStatus

  // Feedback
  notes           String?             @db.Text
  internalNotes   String?             @db.Text
  rejectionReason ReviewRejectionReason?

  // Auto-review flags
  flagsRaised     String[]
  aiConfidenceScore Float?

  createdAt       DateTime            @default(now())

  @@index([projectId, createdAt])
  @@index([reviewerId])
}

model ProjectTag {
  id          String   @id @default(cuid())
  projectId   String
  tag         String
  confidence  Float    @default(1.0)
  source      TagSource @default(MANUAL)

  createdAt   DateTime @default(now())

  @@unique([projectId, tag])
  @@index([projectId])
  @@index([tag])
}

enum ReviewAction {
  SUBMITTED
  APPROVED
  REJECTED
  REQUESTED_CHANGES
  RESUBMITTED
  FLAGGED
  UNFLAGGED
  DEACTIVATE
  REACTIVATE
  SEND_TO_REVIEW
}

enum ReviewRejectionReason {
  INCOMPLETE_INFORMATION
  POLICY_VIOLATION
  PROHIBITED_CONTENT
  INTELLECTUAL_PROPERTY
  FRAUD_SUSPECTED
  UNREALISTIC_GOALS
  MISSING_REWARDS
  IDENTITY_VERIFICATION
  OTHER
}

enum TagSource {
  MANUAL
  AI_GENERATED
  USER_SUGGESTED
}

// ============================================
// RETAILER / LCS SYSTEM
// ============================================

model Retailer {
  id                    String          @id @default(cuid())
  userId                String?         @unique

  // Business Information
  businessName          String
  businessType          RetailerType
  contactName           String
  email                 String          @unique
  phone                 String

