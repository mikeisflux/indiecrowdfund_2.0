  COLLABORATOR_ACCEPTED
  COLLABORATOR_DECLINED
  PROJECT_UPDATE
  PROJECT_FUNDED
  PROJECT_LAUNCHED
  PROJECT_ENDED
  PLEDGE_RECEIVED
  PLEDGE_FAILED
  PLEDGE_SHIPPED
  PLEDGE_DELIVERED
  COMMENT_REPLY
  COMMENT_NEW
  MESSAGE_RECEIVED
  SURVEY_SENT
  SURVEY_REMINDER
  FOLLOWED_PROJECT_LAUNCHED
  SYSTEM
}

// ============================================
// BUG REPORTS
// ============================================

model BugReport {
  id            String           @id @default(cuid())

  // Reporter info
  userId        String?          // Optional - can be anonymous
  name          String?
  email         String

  // Bug details
  title         String
  description   String           @db.Text
  category      BugCategory      @default(OTHER)
  severity      BugSeverity      @default(MEDIUM)
  pageUrl       String?          // URL where bug occurred
  browser       String?          // Browser info
  device        String?          // Device info
  steps         String?          @db.Text // Steps to reproduce
  expectedBehavior String?       @db.Text
  actualBehavior   String?       @db.Text
  screenshot    String?          // URL to screenshot

  // Status tracking
  status        BugStatus        @default(NEW)
  priority      BugPriority      @default(MEDIUM)
  assignedTo    String?          // Admin user ID
  resolution    String?          @db.Text

  // Timestamps
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  resolvedAt    DateTime?

  // Relations
  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([userId])
}

enum BugCategory {
  UI_VISUAL
  FUNCTIONALITY
  PERFORMANCE
  SECURITY
  PAYMENT
  ACCOUNT
  PROJECT
  REWARDS
  OTHER
}

enum BugSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BugStatus {
  NEW
  ACKNOWLEDGED
  IN_PROGRESS
  NEEDS_INFO
  RESOLVED
  CLOSED
  WONT_FIX
}

enum BugPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ============================================
// API KEYS
// ============================================

model ApiKey {
  id            String        @id @default(cuid())

  // Key details
  name          String        // Display name for the key
  key           String        @unique // The actual API key (hashed prefix for display)
  keyHash       String        // Hashed version of the full key for verification
  prefix        String        // First 8 chars for identification (e.g., "sk_live_")

  // Environment
  environment   ApiEnvironment @default(PRODUCTION)

  // Status
  status        ApiKeyStatus  @default(ACTIVE)

  // Usage tracking
  lastUsedAt    DateTime?
  usageCount    Int           @default(0)

  // Timestamps
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  expiresAt     DateTime?     // Optional expiration
  revokedAt     DateTime?

  // Created by admin
  createdById   String?
  createdBy     User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([key])
  @@index([prefix])
  @@index([status])
  @@index([createdById])
}

enum ApiEnvironment {
  PRODUCTION
  DEVELOPMENT
  STAGING
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

// ============================================
// INDIEKIT - FULFILLMENT MANAGEMENT
// ============================================

// Products/SKUs for fulfillment
model FulfillmentProduct {
  id                String            @id @default(cuid())
  projectId         String

  // Product details
  sku               String
  name              String
  description       String?           @db.Text
  type              ProductType       @default(PHYSICAL)
  imageUrl          String?

  // Physical product attributes
  weight            Float?            // in oz
  weightUnit        String?           @default("oz")
  length            Float?            // in inches
  width             Float?            // in inches
  height            Float?            // in inches
  dimensionUnit     String?           @default("in")

  // Customs info for international shipping
  customsCode       String?           // HS/Tariff code
  countryOfOrigin   String?
  customsDescription String?

  // Status
  status            ProductStatus     @default(INCOMPLETE)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([projectId, sku])
  @@index([projectId])
  @@index([status])
}

enum ProductType {
  PHYSICAL
  DIGITAL
}

enum ProductStatus {
  READY
  INCOMPLETE
  NO_WEIGHT
  NO_CUSTOMS
  ERROR
}

// Backer segments for targeted actions
model BackerSegment {
  id                String            @id @default(cuid())
  projectId         String

  name              String
  description       String?
  type              SegmentType       @default(CUSTOM)

  // Filter criteria (stored as JSON)
  criteria          Json?             // { field: "pledgeAmount", operator: ">=", value: 100 }

  // Cached count (updated periodically)
  backerCount       Int               @default(0)

  // Dynamic vs static
  isDynamic         Boolean           @default(true)
  staticBackerIds   String[]          // For static segments, list of pledge IDs

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([projectId])
  @@index([type])
}

enum SegmentType {
  PLEDGE_LEVEL
  ADDON
  SURVEY_STATUS
  SHIPPING_REGION
  PAYMENT_STATUS
  CUSTOM
}

// Activity log for timeline
model FulfillmentActivity {
  id                String              @id @default(cuid())
  projectId         String

  // Activity details
  type              ActivityType
  title             String
  description       String?
  metadata          Json?               // Additional context

  // Related entities
  pledgeId          String?
  userId            String?

  // Grouping for batch operations
  batchId           String?             // Group related activities
  affectedCount     Int?                // Number of items affected

  createdAt         DateTime            @default(now())

  @@index([projectId, createdAt])
  @@index([type])
  @@index([pledgeId])
  @@index([batchId])
}

enum ActivityType {
  SURVEY_SENT
  SURVEY_REMINDER
  SURVEY_COMPLETED
  ORDERS_LOCKED
  ADDRESSES_LOCKED
  CARDS_CHARGED
  CHARGE_FAILED
  ORDERS_PUSHED
  PUSH_FAILED
  ORDER_SHIPPED
  ORDER_DELIVERED
  DIGITAL_DISTRIBUTED
  ADDRESS_UPDATED
  REFUND_ISSUED
  NOTE_ADDED
  BALANCE_ADJUSTED
}

// Support tickets/notes for backers
model BackerNote {
  id                String            @id @default(cuid())
  pledgeId          String

  content           String            @db.Text
  isInternal        Boolean           @default(true)

  // Who created this
  createdById       String?
  createdBy         User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([pledgeId])
  @@index([createdById])
}

// Digital file distribution
model DigitalFile {
  id                String            @id @default(cuid())
  projectId         String

  name              String
  fileName          String
  fileUrl           String
  fileSize          Int               // in bytes
  mimeType          String?

  // Distribution tracking
  totalEligible     Int               @default(0)
  distributedCount  Int               @default(0)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  distributions     DigitalDistribution[]

  @@index([projectId])
}

// Distribution rules and tracking
model DigitalDistribution {
  id                String            @id @default(cuid())
  digitalFileId     String
  pledgeId          String

  // Distribution status
  distributedAt     DateTime?
  downloadedAt      DateTime?
  downloadCount     Int               @default(0)

  digitalFile       DigitalFile       @relation(fields: [digitalFileId], references: [id], onDelete: Cascade)

  createdAt         DateTime          @default(now())

  @@unique([digitalFileId, pledgeId])
  @@index([digitalFileId])
  @@index([pledgeId])
}
