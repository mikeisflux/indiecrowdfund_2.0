// ============================================
// MODERATION & REPORTS
// ============================================

model Report {
  id            String       @id @default(cuid())
  reporterId    String?
  reporterEmail String?

  // What is being reported
  targetType    ReportTarget
  targetId      String
  projectId     String?
  userId        String?

  // Report details
  reason        ReportReason
  description   String       @db.Text
  evidence      String[]

  // Status
  status        ReportStatus @default(PENDING)
  priority      ReportPriority @default(MEDIUM)

  // Resolution
  resolvedBy    String?
  resolvedAt    DateTime?
  resolution    String?      @db.Text
  actionTaken   ReportAction?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, priority])
  @@index([targetType, targetId])
  @@index([projectId])
  @@index([userId])
}

enum ReportTarget {
  PROJECT
  USER
  COMMENT
  MESSAGE
  UPDATE
  REWARD
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  FRAUD
  COPYRIGHT
  INAPPROPRIATE_CONTENT
  MISLEADING
  IMPERSONATION
  OTHER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
  ESCALATED
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ReportAction {
  WARNING_ISSUED
  CONTENT_REMOVED
  USER_SUSPENDED
  USER_BANNED
  PROJECT_SUSPENDED
  PROJECT_REMOVED
  NO_ACTION
}

// ============================================
// MEDIA LIBRARY
// ============================================

model MediaFile {
  id            String     @id @default(cuid())
  uploaderId    String?
  uploader      User?      @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  filename      String
  originalName  String
  mimeType      String
  size          Int
  url           String
  thumbnailUrl  String?

  // Metadata
  width         Int?
  height        Int?
  duration      Int?

  // Organization
  folder        String     @default("uploads")
  tags          String[]
  altText       String?

  // Usage tracking
  usageCount    Int        @default(0)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([uploaderId])
  @@index([folder])
  @@index([mimeType])
}

// ============================================
// PAGE BUILDER
// ============================================

model CustomPage {
  id            String     @id @default(cuid())
  slug          String     @unique
  title         String
  description   String?

  // Page content (JSON structure)
  content       Json

  // SEO
  metaTitle     String?
  metaDescription String?
  ogImage       String?

  // Status
  isPublished   Boolean    @default(false)
  publishedAt   DateTime?

  createdBy     String?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([slug])
  @@index([isPublished])
}

// ============================================
// EMAIL TEMPLATES & CAMPAIGNS
// ============================================

model EmailTemplate {
  id            String     @id @default(cuid())
  name          String     @unique
  subject       String
  htmlContent   String     @db.Text
  textContent   String?    @db.Text

  // Variables that can be used
  variables     String[]

  isActive      Boolean    @default(true)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model EmailCampaign {
  id            String           @id @default(cuid())
  name          String
  subject       String
  htmlContent   String           @db.Text

  // Targeting
  targetAudience String          @default("all")
  filters       Json?

  // Status
  status        CampaignStatus   @default(DRAFT)
  scheduledFor  DateTime?
  sentAt        DateTime?

  // Stats
  recipientCount Int             @default(0)
  sentCount     Int              @default(0)
  openCount     Int              @default(0)
  clickCount    Int              @default(0)
  bounceCount   Int              @default(0)
  unsubscribeCount Int           @default(0)
  conversionCount Int            @default(0)  // Pledges attributed to this campaign

  createdBy     String?

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Relations
  clicks        EmailCampaignClick[]
  conversions   Pledge[]         @relation("CampaignConversions")

  @@index([status])
}

// Track individual email link clicks for conversion attribution
model EmailCampaignClick {
  id          String    @id @default(cuid())
  campaignId  String
  email       String?   // Email address that was sent to
  userId      String?   // User ID if logged in or matched
  url         String    // The URL they clicked
  ipAddress   String?   // For matching anonymous users
  userAgent   String?   // Browser info
  clickedAt   DateTime  @default(now())
  converted   Boolean   @default(false)
  convertedAt DateTime?
  pledgeId    String?   // If converted, link to the pledge

  campaign    EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id])

  @@index([campaignId])
  @@index([email])
  @@index([userId])
  @@index([clickedAt])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

// ============================================
// CREATOR EMAIL LIST (Per-user subscriber list)
// ============================================

model EmailListSubscriber {
  id              String    @id @default(cuid())
  creatorId       String    // The creator who owns this subscriber
  email           String
  name            String?
  status          String    @default("subscribed") // subscribed, unsubscribed, bounced
  source          String?   // Where they signed up: import, teaser, project, manual
  sourceProjectId String?   // If signed up from a specific project
  tags            String[]  // For segmentation

  // Engagement tracking
  lastEmailSentAt DateTime?
  lastOpenedAt    DateTime?
  lastClickedAt   DateTime?

  creator         User      @relation("CreatorEmailList", fields: [creatorId], references: [id], onDelete: Cascade)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([creatorId, email])
  @@index([creatorId])
  @@index([email])
  @@index([status])
}

// ============================================
// MAILBOX MANAGEMENT
// ============================================

model Mailbox {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  description   String?
  color         String?       @default("#3B82F6")

  // IMAP/SMTP settings for external mailboxes (optional)
  imapHost      String?
  imapPort      Int?
  smtpHost      String?
  smtpPort      Int?
  username      String?
  password      String?       // Encrypted
  useSSL        Boolean       @default(true)

  isDefault     Boolean       @default(false)
  isActive      Boolean       @default(true)
  isCreatorMailbox Boolean    @default(false)  // True for auto-created creator mailboxes

  emails        AdminEmail[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([isActive])
}

// Email Queue for rate-limited sending (1 email per second max)
model EmailQueue {
  id            String           @id @default(cuid())

  // Email details
  toEmail       String
  subject       String
  bodyHtml      String           @db.Text
  bodyText      String?          @db.Text
  fromEmail     String?
  fromName      String?
  replyTo       String?
  isCreatorEmail Boolean         @default(false)

  // Queue status
  status        EmailQueueStatus @default(PENDING)
  priority      Int              @default(0)  // Higher = more urgent
  attempts      Int              @default(0)
  maxAttempts   Int              @default(3)
  error         String?

  // Timestamps
  createdAt     DateTime         @default(now())
  processedAt   DateTime?
  sentAt        DateTime?

  @@index([status, priority, createdAt])
  @@index([createdAt])
}

enum EmailQueueStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model AdminEmail {
  id            String           @id @default(cuid())
  mailboxId     String

  // Email details
  fromEmail     String
  fromName      String?
  toEmail       String
  toName        String?
  ccEmails      String[]
  bccEmails     String[]
  replyTo       String?
  subject       String
  bodyHtml      String           @db.Text
  bodyText      String?          @db.Text

  // Folder/status
  folder        EmailFolder      @default(INBOX)
  status        AdminEmailStatus @default(PENDING)

  // Tracking
  isRead        Boolean          @default(false)
  isStarred     Boolean          @default(false)
  isArchived    Boolean          @default(false)

  // Dates
  sentAt        DateTime?
  receivedAt    DateTime?
  openedAt      DateTime?

  // Thread support
  threadId      String?
  inReplyTo     String?

  // Attachments stored as JSON array
  attachments   Json?

  mailbox       Mailbox          @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([mailboxId, folder])
  @@index([mailboxId, status])
  @@index([mailboxId, isRead])
  @@index([threadId])
}

enum EmailFolder {
  INBOX
  SENT
  DRAFTS
  TRASH
  SPAM
  ARCHIVE
}

enum AdminEmailStatus {
  PENDING
  SENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

// ============================================
// ID VERIFICATION
// ============================================

model IDVerification {
  id                String                 @id @default(cuid())
  userId            String

  // Shufti Reference
  shuftiReference   String                 @unique
  verificationUrl   String?

  // Verification Status
  status            IDVerificationStatus   @default(PENDING)

  // Results
  isDocumentValid   Boolean?
  isFaceMatch       Boolean?
  isAgeVerified     Boolean?
  detectedAge       Int?
  documentType      String?
  documentCountry   String?

  // Decline info
  declineReason     String?
  declineCodes      String[]

  // Raw response (for debugging)
  rawResponse       Json?

  // Timestamps
  requestedAt       DateTime              @default(now())
  completedAt       DateTime?
  expiresAt         DateTime?

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([shuftiReference])
  @@index([status])
}

enum IDVerificationStatus {
  PENDING
  PROCESSING
  VERIFIED
  DECLINED
  EXPIRED
  CANCELLED
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id          String             @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  message     String
  read        Boolean            @default(false)
  actionUrl   String?

  // Related entities (optional)
  projectId   String?
  senderId    String?            // For collaborator invites, this would be the project creator

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime           @default(now())
  readAt      DateTime?

  @@index([userId, read])
  @@index([userId, createdAt])
}

enum NotificationType {
  COLLABORATOR_INVITE
  COLLABORATOR_ACCEPTED
  COLLABORATOR_DECLINED
  PROJECT_UPDATE
  PROJECT_FUNDED
  PROJECT_LAUNCHED
  PROJECT_ENDED
  PLEDGE_RECEIVED
  PLEDGE_FAILED
  PLEDGE_SHIPPED
  PLEDGE_DELIVERED
  COMMENT_REPLY
  COMMENT_NEW
  MESSAGE_RECEIVED
  SURVEY_SENT
  SURVEY_REMINDER
  FOLLOWED_PROJECT_LAUNCHED
  MARKETPLACE_BOOK_APPROVED
  MARKETPLACE_BOOK_REJECTED
  MARKETPLACE_PURCHASE
  SYSTEM
}

// ============================================
// BUG REPORTS
// ============================================

model BugReport {
  id            String           @id @default(cuid())

  // Reporter info
  userId        String?          // Optional - can be anonymous
  name          String?
  email         String

  // Bug details
  title         String
  description   String           @db.Text
  category      BugCategory      @default(OTHER)
  severity      BugSeverity      @default(MEDIUM)
  pageUrl       String?          // URL where bug occurred
  browser       String?          // Browser info
  device        String?          // Device info
  steps         String?          @db.Text // Steps to reproduce
  expectedBehavior String?       @db.Text
  actualBehavior   String?       @db.Text
  screenshot    String?          // URL to screenshot

  // Status tracking
  status        BugStatus        @default(NEW)
  priority      BugPriority      @default(MEDIUM)
  assignedTo    String?          // Admin user ID
  resolution    String?          @db.Text

  // Timestamps
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  resolvedAt    DateTime?

  // Relations
  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([userId])
}

enum BugCategory {
  UI_VISUAL
  FUNCTIONALITY
  PERFORMANCE
  SECURITY
  PAYMENT
  ACCOUNT
  PROJECT
  REWARDS
  OTHER
}

enum BugSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BugStatus {
  NEW
  ACKNOWLEDGED
  IN_PROGRESS
  NEEDS_INFO
  RESOLVED
  CLOSED
  WONT_FIX
}

enum BugPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ============================================
// API KEYS
// ============================================

model ApiKey {
  id            String        @id @default(cuid())

  // Key details
  name          String        // Display name for the key
  key           String        @unique // The actual API key (hashed prefix for display)
  keyHash       String        // Hashed version of the full key for verification
  prefix        String        // First 8 chars for identification (e.g., "sk_live_")

  // Environment
  environment   ApiEnvironment @default(PRODUCTION)

  // Status
  status        ApiKeyStatus  @default(ACTIVE)

  // Usage tracking
  lastUsedAt    DateTime?
  usageCount    Int           @default(0)

  // Timestamps
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  expiresAt     DateTime?     // Optional expiration
  revokedAt     DateTime?

  // Created by admin
  createdById   String?
  createdBy     User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([key])
  @@index([prefix])
  @@index([status])
  @@index([createdById])
}

enum ApiEnvironment {
  PRODUCTION
  DEVELOPMENT
  STAGING
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

// ============================================
// INDIEKIT - FULFILLMENT MANAGEMENT
// ============================================

// Products/SKUs for fulfillment
model FulfillmentProduct {
  id                String            @id @default(cuid())
  projectId         String

  // Product details
  sku               String
  name              String
  description       String?           @db.Text
  type              ProductType       @default(PHYSICAL)
  imageUrl          String?

  // Physical product attributes
  weight            Float?            // in oz
  weightUnit        String?           @default("oz")
  length            Float?            // in inches
  width             Float?            // in inches
  height            Float?            // in inches
  dimensionUnit     String?           @default("in")

  // Customs info for international shipping
  customsCode       String?           // HS/Tariff code
  countryOfOrigin   String?
  customsDescription String?

  // Status
  status            ProductStatus     @default(INCOMPLETE)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([projectId, sku])
  @@index([projectId])
  @@index([status])
}

enum ProductType {
  PHYSICAL
  DIGITAL
}

enum ProductStatus {
  READY
  INCOMPLETE
  NO_WEIGHT
  NO_CUSTOMS
  ERROR
}

// Backer segments for targeted actions
model BackerSegment {
  id                String            @id @default(cuid())
  projectId         String

  name              String
  description       String?
  type              SegmentType       @default(CUSTOM)

  // Filter criteria (stored as JSON)
  criteria          Json?             // { field: "pledgeAmount", operator: ">=", value: 100 }

  // Cached count (updated periodically)
  backerCount       Int               @default(0)

  // Dynamic vs static
  isDynamic         Boolean           @default(true)
  staticBackerIds   String[]          // For static segments, list of pledge IDs

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([projectId])
  @@index([type])
}

enum SegmentType {
  PLEDGE_LEVEL
  ADDON
  SURVEY_STATUS
  SHIPPING_REGION
  PAYMENT_STATUS
  CUSTOM
}

// Activity log for timeline
model FulfillmentActivity {
  id                String              @id @default(cuid())
  projectId         String

  // Activity details
  type              ActivityType
  title             String
  description       String?
  metadata          Json?               // Additional context

  // Related entities
  pledgeId          String?
  userId            String?

  // Grouping for batch operations
  batchId           String?             // Group related activities
  affectedCount     Int?                // Number of items affected

  createdAt         DateTime            @default(now())

  @@index([projectId, createdAt])
  @@index([type])
  @@index([pledgeId])
  @@index([batchId])
}

enum ActivityType {
  SURVEY_SENT
  SURVEY_REMINDER
  SURVEY_COMPLETED
  ORDERS_LOCKED
  ADDRESSES_LOCKED
  CARDS_CHARGED
  CHARGE_FAILED
  ORDERS_PUSHED
  PUSH_FAILED
  ORDER_SHIPPED
  ORDER_DELIVERED
  DIGITAL_DISTRIBUTED
  ADDRESS_UPDATED
  REFUND_ISSUED
  NOTE_ADDED
  BALANCE_ADJUSTED
}

// Support tickets/notes for backers
model BackerNote {
  id                String            @id @default(cuid())
  pledgeId          String

  content           String            @db.Text
  isInternal        Boolean           @default(true)

  // Who created this
  createdById       String?
  createdBy         User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([pledgeId])
  @@index([createdById])
}

// Digital file distribution
model DigitalFile {
  id                String            @id @default(cuid())
  projectId         String
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name              String
  description       String?           @db.Text
  fileName          String
  fileUrl           String            // Legacy URL or public domain URL
  r2StorageKey      String?           // Cloudflare R2 storage key
  fileSize          Int               // in bytes
  mimeType          String?

  // Access control - which rewards/addons grant access
  accessType        DigitalAccessType @default(ALL_BACKERS)
  rewardIds         String[]          // Reward IDs that grant access
  addonIds          String[]          // Addon IDs that grant access

  // Distribution tracking
  totalEligible     Int               @default(0)
  distributedCount  Int               @default(0)
  downloadCount     Int               @default(0)

  // PDF Cover Extraction (for Digital Library)
  coverImageUrl     String?           // Generated PDF first page thumbnail
  coverExtractedAt  DateTime?         // When cover was generated
  coverExtractionFailed Boolean       @default(false)  // If extraction failed
  totalPages        Int?              // Total page count in PDF

  // Uploaded by
  uploadedById      String?
  uploadedBy        User?             @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  distributions     DigitalDistribution[]
  distributionRules DistributionRule[]

  @@index([projectId])
  @@index([uploadedById])
}

enum DigitalAccessType {
  ALL_BACKERS       // All backers can access
  SPECIFIC_REWARDS  // Only specific reward tiers
  SPECIFIC_ADDONS   // Only specific addons
  REWARD_AND_ADDON  // Specific rewards or addons
}

// Distribution rules and tracking
model DigitalDistribution {
  id                String            @id @default(cuid())
  digitalFileId     String
  pledgeId          String

  // Distribution status
  distributedAt     DateTime?
  downloadedAt      DateTime?
  downloadCount     Int               @default(0)

  // Reading Progress (for Digital Library)
  readingProgress   Json?             // { currentPage: number, totalPages: number, lastPosition: string }
  lastReadAt        DateTime?
  readingStatus     ReadingStatus     @default(UNREAD)

  digitalFile       DigitalFile       @relation(fields: [digitalFileId], references: [id], onDelete: Cascade)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt @default(now())

  @@unique([digitalFileId, pledgeId])
  @@index([digitalFileId])
  @@index([pledgeId])
}

enum ReadingStatus {
  UNREAD
  IN_PROGRESS
  COMPLETED
}

// Distribution rules - defines which file gets distributed when conditions are met
model DistributionRule {
  id                String                      @id @default(cuid())
  projectId         String
  digitalFileId     String
  digitalFile       DigitalFile                 @relation(fields: [digitalFileId], references: [id], onDelete: Cascade)

  name              String
  description       String?

  // Trigger conditions
  triggerType       DistributionTriggerType     @default(ALL_BACKERS)
  triggerRewardId   String?                     // If triggering on a specific reward
  triggerAddonId    String?                     // If triggering on a specific addon

  // Requirements
  requiresPayment   Boolean                     @default(false)  // Must payment be completed?

  // Status tracking
  status            DistributionRuleStatus      @default(NOT_STARTED)
  distributedCount  Int                         @default(0)
  totalEligible     Int                         @default(0)

  // Timestamps
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@index([projectId])
  @@index([digitalFileId])
  @@index([status])
}

enum DistributionTriggerType {
  ALL_BACKERS       // All backers get the file
  SPECIFIC_REWARD   // Only backers of a specific reward tier
  SPECIFIC_ADDON    // Only backers who purchased a specific addon
}

enum DistributionRuleStatus {
  NOT_STARTED
  STARTED
  COMPLETED
}

// ============================================
// ACHIEVEMENT BADGES & REDEMPTION BONUSES
// ============================================

model UserAchievement {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  badgeType   BadgeType
  earnedAt    DateTime    @default(now())

  // Metadata about how badge was earned
  metadata    Json?       // { projectId, pledgeId, etc }

  @@unique([userId, badgeType])
  @@index([userId])
}

enum BadgeType {
  FIRST_PLEDGE                // First pledge ever
  SUPER_BACKER_10            // Backed 10+ projects
  SUPER_BACKER_25            // Backed 25+ projects
  SUPER_BACKER_50            // Backed 50+ projects
  EARLY_BIRD                 // Pledged within first 24 hours
  STRETCH_GOAL_CONTRIBUTOR   // Contributed to reaching stretch goal
  PREMIUM_SUPPORTER          // Pledged $500+ total
  SURVEY_CHAMPION            // Completed 10+ surveys promptly
  SURVEY_COMPLETIONIST       // Completed all pending surveys
  REFERRAL_MASTER            // Referred 5+ successful backers
  ANNIVERSARY_BACKER         // Active backer for 1+ year
}

// Monthly redemption bonus tracking with Decimal for precision
model RedemptionBonusLedger {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Month tracking (first day of month)
  month           DateTime

  // Bonus calculation (using Decimal for financial precision)
  totalBadges     Int      @default(0)
  rawBonusPercent Decimal  @db.Decimal(10, 6)  // Sum of badge bonuses before cap (e.g., 0.000500 for 0.05%)
  appliedBonusPercent Decimal @db.Decimal(10, 6)  // After 0.03% cap applied

  // Usage tracking
  redemptionCount Int      @default(0)
  totalBonusApplied Decimal @default(0) @db.Decimal(10, 2)  // Total $ saved from bonus

  applications    RedemptionBonusApplication[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, month])
  @@index([userId, month])
}

// Track individual bonus applications to redemptions
model RedemptionBonusApplication {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  redemptionId          String   // Link to DivinityCoinRedemption
  bonusLedgerId         String
  bonusLedger           RedemptionBonusLedger @relation(fields: [bonusLedgerId], references: [id], onDelete: Cascade)

  bonusPercentApplied   Decimal  @db.Decimal(10, 6)
  bonusAmountSaved      Decimal  @db.Decimal(10, 2)  // Actual $ saved

  appliedAt             DateTime @default(now())

  @@index([userId])
  @@index([bonusLedgerId])
  @@index([redemptionId])
}

// ============================================
// BACKER DASHBOARD ENHANCEMENTS
// ============================================

// User saved addresses for shipping
model UserAddress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  label       String   // "Home", "Work", "Office", etc.
  isDefault   Boolean  @default(false)

  // Address fields
  fullName    String
  line1       String
  line2       String?
  city        String
  state       String
  postalCode  String
  country     String
  phone       String?

  // Validation
  isValidated Boolean  @default(false)
  validatedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([userId, isDefault])
}

// Project collections/wishlists
model ProjectCollection {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?
  isPublic    Boolean  @default(false)
  color       String?  // For UI theming

  projects    ProjectCollectionItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([isPublic])
}

model ProjectCollectionItem {
  id           String   @id @default(cuid())
  collectionId String
  collection   ProjectCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  notes        String?  // Personal notes about the project
  addedAt      DateTime @default(now())

  @@unique([collectionId, projectId])
  @@index([collectionId])
  @@index([projectId])
}

// Notification preferences per project
model ProjectNotificationPreference {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Notification types
  updates     Boolean  @default(true)
  comments    Boolean  @default(true)
  surveys     Boolean  @default(true)
  shipping    Boolean  @default(true)
  messages    Boolean  @default(true)

  // Email digest frequency
  digestFrequency String @default("instant") // instant, daily, weekly, none

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

// Creator follow relationship
model CreatorFollow {
  id          String   @id @default(cuid())
  followerId  String   // The user doing the following
  follower    User     @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  creatorId   String   // The creator being followed
  creator     User     @relation("Following", fields: [creatorId], references: [id], onDelete: Cascade)

  // Notification preferences for this follow
  notifyNewProjects Boolean @default(true)
  notifyUpdates     Boolean @default(true)

  createdAt   DateTime @default(now())

  @@unique([followerId, creatorId])
  @@index([followerId])
  @@index([creatorId])
}

// ============================================
// DIGITAL MARKETPLACE
// ============================================

model MarketplaceBook {
  id                String   @id @default(cuid())
  creatorId         String
  creator           User     @relation("MarketplaceCreator", fields: [creatorId], references: [id])

  // Basic Info
  title             String
  slug              String
  description       String   @db.Text  // Rich text HTML
  shortDescription  String?  @db.VarChar(300)

  // Media
  coverImageUrl     String?
  promoVideoUrl     String?
  galleryImages     Json?    // Array of image URLs

  // Pricing
  price             Decimal  @db.Decimal(10, 2)
  currency          String   @default("USD")

  // Digital File
  pdfFileUrl        String   // R2 storage URL
  pdfFileName       String?
  pdfFileSize       Int?     // In bytes

  // PDF Cover Extraction
  pdfCoverImageUrl  String?  // Auto-extracted first page as cover
  pdfCoverExtractedAt DateTime?
  pdfCoverExtractionFailed Boolean @default(false)
  pdfTotalPages     Int?     // Total page count

  // Content Flags
  hasAdultContent   Boolean  @default(false)
  hasRiskyContent   Boolean  @default(false)
  promoContentSfw   Boolean  @default(true)
  paymentProcessor  PaymentProcessor @default(STRIPE)

  // Status & Moderation
  status            MarketplaceBookStatus @default(DRAFT)
  submittedAt       DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  rejectionReason   String?
  deactivatedAt     DateTime?
  deactivationReason String?

  // Featured/Curated
  isFeatured        Boolean  @default(false)
  isStaffPick       Boolean  @default(false)
  featuredOrder     Int?
  staffPickOrder    Int?

  // Categorization
  category          String?
  tags              String[] @default([])

  // Stats
  purchaseCount     Int      @default(0)
  viewCount         Int      @default(0)

  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  publishedAt       DateTime?
  deletedAt         DateTime?  // Soft delete

  // Relations
  purchases         MarketplacePurchase[]
  reviews           MarketplaceBookReview[]
  codeRedemptions   MarketplaceCodeRedemption[]
  discountCodes     MarketplaceDiscountCode[] @relation("MarketplaceDiscountBook")
  companyId         String?
  company           CompanyProfile? @relation(fields: [companyId], references: [id])

  @@unique([creatorId, slug])
  @@index([status])
  @@index([isFeatured])
  @@index([isStaffPick])
  @@index([category])
  @@index([createdAt])
  @@index([deletedAt])
}

enum MarketplaceBookStatus {
  DRAFT
  SUBMITTED
  PENDING_REVIEW
  APPROVED
  REJECTED
  LIVE
  DEACTIVATED
  ARCHIVED
}

model CompanyProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])

  // Profile Info
  name              String
  slug              String   @unique
  tagline           String?  @db.VarChar(200)
  about             String?  @db.Text  // Rich text HTML

  // Media
  bannerImageUrl    String?
  logoUrl           String?

  // Contact & Social
  website           String?
  socialLinks       Json?    // { twitter, facebook, instagram, etc. }
  physicalMediaUrl  String?  // Link to order physical copies (books, merch, etc.)

  // Status
  isActive          Boolean  @default(true)
  isVerified        Boolean  @default(false)

  // Stats
  bookCount         Int      @default(0)
  totalSales        Int      @default(0)

  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  books             MarketplaceBook[]

  @@index([slug])
  @@index([isActive])
}

model MarketplacePurchase {
  id                String   @id @default(cuid())
  bookId            String
  book              MarketplaceBook @relation(fields: [bookId], references: [id])
  buyerId           String
  buyer             User     @relation("MarketplaceBuyer", fields: [buyerId], references: [id])

  // Transaction
  amount            Decimal  @db.Decimal(10, 2)
  platformFee       Decimal  @default(0) @db.Decimal(10, 2)
  creatorPayout     Decimal  @default(0) @db.Decimal(10, 2)
  currency          String   @default("USD")
  paymentProcessor  PaymentProcessor
  transactionId     String?  // Stripe or DivinityCoin transaction ID

  // Stripe fields
  stripePaymentIntentId    String?  @unique
  stripeCheckoutSessionId  String?  @unique
  stripeCustomerId         String?

  // DivinityCoin fields
  divinityCoinPaymentId String?  @unique

  // Status
  status            MarketplacePurchaseStatus @default(PENDING)
  completedAt       DateTime?
  refundedAt        DateTime?
  refundReason      String?

  // Delivery
  deliveredAt       DateTime?
  downloadCount     Int      @default(0)
  lastDownloadedAt  DateTime?

  // Reading Progress (synced from Digital Library)
  readingProgress   Json?    // { currentPage: number, totalPages: number }
  lastReadAt        DateTime?

  // Discount code relation
  codeRedemption    MarketplaceCodeRedemption?

  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([buyerId])
  @@index([bookId])
  @@index([status])
}

enum MarketplacePurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model MarketplaceBookReview {
  id                String   @id @default(cuid())
  bookId            String
  book              MarketplaceBook @relation(fields: [bookId], references: [id])
  reviewerId        String
  reviewer          User     @relation("MarketplaceReviewer", fields: [reviewerId], references: [id])

  // Review Content
  action            MarketplaceReviewAction
  previousStatus    MarketplaceBookStatus?
  newStatus         MarketplaceBookStatus
  notes             String?  @db.Text
  internalNotes     String?  @db.Text
  rejectionReason   String?

  // AI Analysis
  flagsRaised       String[] @default([])
  aiConfidenceScore Float?

  // Timestamps
  createdAt         DateTime @default(now())

  @@index([bookId])
  @@index([reviewerId])
}

enum MarketplaceReviewAction {
  SUBMITTED
  APPROVED
  REJECTED
  REQUESTED_CHANGES
  FLAGGED
  DEACTIVATED
  REACTIVATED
}

// ============================================
// MARKETPLACE DISCOUNT CODES
// ============================================

model MarketplaceDiscountCode {
  id                String   @id @default(cuid())
  creatorId         String
  creator           User     @relation("MarketplaceDiscountCreator", fields: [creatorId], references: [id])

  // Specific book this code applies to
  bookId            String?
  book              MarketplaceBook? @relation("MarketplaceDiscountBook", fields: [bookId], references: [id])

  // Code details
  code              String   @unique
  type              MarketplaceDiscountType @default(FREE_BOOK)

  // Validity period (monthly)
  validFrom         DateTime
  validUntil        DateTime

  // Usage limits
  maxRedemptions    Int      @default(0)  // Max times this code can be used (0 = unlimited)
  maxPerCustomer    Int      @default(1)  // Max times per customer
  usageCount        Int      @default(0)  // Current usage count

  // Status
  isActive          Boolean  @default(true)

  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  redemptions       MarketplaceCodeRedemption[]

  @@index([creatorId])
  @@index([bookId])
  @@index([code])
  @@index([validFrom, validUntil])
  @@index([isActive])
}

model MarketplaceCodeRedemption {
  id                String   @id @default(cuid())
  codeId            String
  code              MarketplaceDiscountCode @relation(fields: [codeId], references: [id])
  customerId        String
  customer          User     @relation("MarketplaceCodeCustomer", fields: [customerId], references: [id])
  bookId            String
  book              MarketplaceBook @relation(fields: [bookId], references: [id])
  purchaseId        String?  @unique
  purchase          MarketplacePurchase? @relation(fields: [purchaseId], references: [id])

  // Amount saved
  discountAmount    Decimal  @db.Decimal(10, 2)

  // Timestamps
  redeemedAt        DateTime @default(now())

  @@unique([codeId, customerId, bookId])
  @@index([codeId])
  @@index([customerId])
  @@index([bookId])
}

enum MarketplaceDiscountType {
  FREE_BOOK         // 100% off one book
  PERCENTAGE        // Future: percentage discount
  FIXED_AMOUNT      // Future: fixed dollar amount off
}

// ==================== CHANGELOG ====================

model ChangelogEntry {
  id          String   @id @default(cuid())

  // Content
  title       String
  description String   @db.Text
  category    ChangelogCategory
  version     String?  // e.g., "1.0.0", "2024-01"

  // Git reference
  commitHash  String?
  branch      String?

  // Publishing
  isPublished Boolean  @default(false)
  publishedAt DateTime?

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Author (admin who created)
  authorId    String?
  author      User?    @relation("ChangelogAuthor", fields: [authorId], references: [id])

  @@index([category])
  @@index([isPublished])
  @@index([publishedAt])
}

enum ChangelogCategory {
  FEATURE
  BUGFIX
  IMPROVEMENT
  SECURITY
  PERFORMANCE
  UI_UX
  API
  DOCUMENTATION
  OTHER
}

// ==================== EMAIL BLOCKLIST ====================

model EmailBlocklist {
  id            String              @id @default(cuid())

  // What to block
  type          EmailBlocklistType
  value         String              // email address, domain, or IP

  // Metadata
  reason        String?             @db.Text
  source        String?             // How it was added (manual, auto-spam, bounce, etc.)

  // Stats
  blockedCount  Int                 @default(0)  // How many emails were blocked
  lastBlockedAt DateTime?

  // Status
  isActive      Boolean             @default(true)
  expiresAt     DateTime?           // Optional expiration for temporary blocks

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([type, value])
  @@index([type])
  @@index([isActive])
  @@index([value])
}

enum EmailBlocklistType {
  EMAIL       // Specific email address
  DOMAIN      // Entire domain (e.g., spam.com)
  IP          // IP address
  PATTERN     // Regex pattern (e.g., *@tempmail.*)
}

// ============================================
// FULFILLMENT INTEGRATIONS
// ============================================

model FulfillmentIntegration {
  id              String                    @id @default(cuid())
  projectId       String
  project         Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Integration type
  provider        FulfillmentProvider

  // Credentials (encrypted)
  credentials     Json                      // { apiKey, apiSecret, shopDomain, accessToken, etc. }

  // Connection status
  status          FulfillmentIntegrationStatus @default(PENDING)
  lastSyncAt      DateTime?
  lastSyncError   String?

  // Stats
  ordersPushed    Int                       @default(0)
  ordersShipped   Int                       @default(0)
  ordersFailed    Int                       @default(0)

  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@unique([projectId, provider])
  @@index([projectId])
  @@index([provider])
  @@index([status])
}

enum FulfillmentProvider {
  SHOPIFY
  SHIPSTATION
  SHIPPO
  EASYPOST
  MANUAL
}

enum FulfillmentIntegrationStatus {
  PENDING
  CONNECTED
  ERROR
  DISCONNECTED
}

// Shopify fulfillment order tracking
model ShopifyFulfillmentOrder {
  id                  String    @id @default(cuid())
  projectId           String
  pledgeId            String

  // Shopify IDs
  shopifyOrderId      String    // Shopify order ID
  shopifyFulfillmentId String?  // Shopify fulfillment ID (once fulfilled)

  // Order details
  orderNumber         String?
  status              ShopifyOrderStatus @default(PENDING)

  // Tracking
  trackingNumber      String?
  trackingCompany     String?
  trackingUrl         String?

  // Timestamps
  pushedAt            DateTime?
  fulfilledAt         DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?

  // Error handling
  lastError           String?   @db.Text
  errorCount          Int       @default(0)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([projectId, pledgeId])
  @@unique([shopifyOrderId])
  @@index([projectId])
  @@index([pledgeId])
  @@index([status])
}

enum ShopifyOrderStatus {
  PENDING           // Not yet pushed to Shopify
  PUSHED            // Order created in Shopify
  PROCESSING        // Being processed by Shopify
  FULFILLED         // Fulfilled but not shipped
  SHIPPED           // Shipped with tracking
  DELIVERED         // Delivered to customer
  FAILED            // Push failed
  CANCELLED         // Order cancelled
}

// SKU mapping for Shopify fulfillment
model ShopifySkuMapping {
  id                String    @id @default(cuid())
  projectId         String

  // Source item (reward or addon)
  sourceType        SkuMappingSourceType
  sourceId          String    // Reward ID or ProjectItem ID
  sourceName        String    // Cached name for display

  // Shopify mapping
  shopifySku        String
  shopifyProductId  String?   // Optional Shopify product ID
  shopifyVariantId  String?   // Optional Shopify variant ID
  shopifyProductName String?  // Cached product name from Shopify

  // Quantity mapping (e.g., 1 reward = 2 SKUs)
  quantity          Int       @default(1)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([projectId, sourceType, sourceId])
  @@index([projectId])
  @@index([shopifySku])
}

enum SkuMappingSourceType {
  REWARD            // Reward tier
  ADDON             // Add-on item
  PROJECT_ITEM      // Individual project item
}
