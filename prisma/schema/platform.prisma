// ============================================
// PLATFORM SETTINGS
// ============================================

model PlatformSettings {
  id                    String   @id @default("default")

  // General Settings
  siteName              String   @default("IndieCrowdfund")
  siteDescription       String?  @db.Text
  supportEmail          String   @default("support@indiecrowdfund.com")
  timezone              String   @default("America/New_York")
  currency              String   @default("USD")
  platformFee           Float    @default(5)
  maintenanceMode       Boolean  @default(false)
  logoUrl               String?
  faviconUrl            String?

  // API Keys (encrypted in production)
  googlePlacesApiKey    String?

  // Stripe Settings
  stripeEnabled         Boolean  @default(true)
  stripeSecretKey       String?  @db.Text
  stripePublishableKey  String?
  stripeWebhookSecret   String?
  stripeConnectWebhookSecret String?  // Separate webhook secret for Stripe Connect events

  // DivinityCoin Settings - Universal credit redemption payment solution
  divinityCoinEnabled   Boolean  @default(false)
  divinityCoinApiKey    String?
  divinityCoinWebhookSecret String?
  divinityCoinPartnerId String?
  divinityCoinSettlementFrequency String @default("weekly")
  divinityCoinStripePublishableKey String?  // DC's Stripe publishable key for rendering card form

  // PayPal Settings
  paypalEnabled         Boolean  @default(false)
  paypalClientId        String?
  paypalClientSecret    String?  @db.Text
  paypalWebhookId       String?
  paypalMode            String   @default("live")  // "live" or "sandbox"

  // Whop Settings
  whopEnabled           Boolean  @default(false)
  whopApiKey            String?
  whopPlanId            String?
  whopCompanyId         String?
  whopWebhookSecret     String?
  whopEnvironment       String   @default("production")  // "production" or "sandbox"

  // Payout Settings
  autoPayouts           Boolean  @default(false)

  // Email Settings
  emailProvider         String   @default("sendgrid")
  smtpHost              String?
  smtpPort              Int      @default(587)
  smtpUser              String?
  smtpPassword          String?
  smtpFromEmail         String?
  smtpFromName          String?
  smtpReplyToEmail      String?
  sendgridApiKey        String?
  sendgridWebhookVerificationKey String?  // ECDSA public key for verifying SendGrid event webhooks
  mailgunApiKey         String?
  mailgunDomain         String?
  mailgunWebhookSigningKey String?  // Mailgun webhook signing key for verifying event webhooks
  emailVerificationRequired Boolean @default(false)
  welcomeEmailEnabled   Boolean  @default(true)
  pledgeConfirmationEnabled Boolean @default(true)
  projectUpdateNotifications Boolean @default(true)

  // Email Queue Settings
  emailQueueEnabled     Boolean  @default(true)  // Enable/disable email queue processing
  emailQueuePausedAt    DateTime?  // Timestamp when queue was paused

  // Social Settings
  twitterHandle         String?
  facebookUrl           String?
  instagramHandle       String?
  youtubeUrl            String?
  discordUrl            String?

  // Social OAuth Settings
  facebookAppId         String?
  facebookAppSecret     String?
  facebookPageAccessToken String?
  youtubeClientId       String?
  youtubeClientSecret   String?
  youtubeApiKey         String?
  twitterApiKey         String?
  twitterApiSecret      String?
  twitterBearerToken    String?
  twitterAccessToken    String?
  twitterAccessSecret   String?

  // Image Generation API Keys
  dalleApiKey           String?  // Deprecated - kept for DB compatibility
  stabilityApiKey       String?

  // Social Auto-Posting Settings
  autoPostEnabled       Boolean  @default(false)
  postApprovalRequired  Boolean  @default(true)

  // AI Settings
  aiProvider            String   @default("anthropic")
  openaiApiKey          String?  // Deprecated - kept for DB compatibility
  anthropicApiKey       String?
  aiAutoModeration      Boolean  @default(false)
  aiAutoTagging         Boolean  @default(false)
  aiContentGeneration   Boolean  @default(false)
  aiFraudDetection      Boolean  @default(true)

  // AI Marketing Settings
  aiAutoTagConfidence   Int      @default(75)
  aiMaxTags             Int      @default(5)
  aiEmailPersonalization Boolean @default(false)
  aiBehaviorTracking    Boolean  @default(false)
  aiPredictiveAnalytics Boolean  @default(false)
  aiSmartSegmentation   Boolean  @default(false)
  aiAutoOptimization    Boolean  @default(false)
  aiSendTimeOptimization Boolean @default(false)
  aiContentOptimization Boolean  @default(false)
  aiAbTesting           Boolean  @default(false)
  aiEmailFrequencyCap   Int      @default(3)
  aiDailyEmailLimit     Int      @default(1000)
  aiQuietHoursStart     String   @default("22:00")
  aiQuietHoursEnd       String   @default("08:00")
  aiCronSchedules       String?  @db.Text // JSON string for cron job schedules

  // Behavior Tracking Settings
  aiTrackPageViews      Boolean  @default(true)
  aiTrackScrollDepth    Boolean  @default(false)
  aiTrackTimeOnPage     Boolean  @default(true)
  aiTrackClicks         Boolean  @default(true)
  aiTrackHovers         Boolean  @default(false)
  aiTrackFormInteractions Boolean @default(false)
  aiTrackVideoEngagement Boolean @default(false)
  aiTrackRewardComparisons Boolean @default(false)
  aiTrackAbandonedCarts Boolean  @default(true)
  aiSessionRecording    Boolean  @default(false)
  aiHeatmaps            Boolean  @default(false)
  aiFunnelAnalysis      Boolean  @default(true)
  aiRetentionDays       Int      @default(90)

  // ID Verification Settings (Shufti Pro)
  idVerificationEnabled Boolean  @default(false)
  shuftiClientId        String?
  shuftiSecretKey       String?
  shuftiCallbackUrl     String?
  shuftiRedirectUrl     String?
  idVerificationMinAge  Int      @default(18)
  idVerificationMode    String   @default("production") // "sandbox" or "production"

  // Security Settings
  twoFactorRequired     Boolean  @default(false)
  sessionTimeout        Int      @default(7)
  maxLoginAttempts      Int      @default(5)
  passwordMinLength     Int      @default(8)
  requireSpecialChars   Boolean  @default(true)
  // Global Rate Limiting (for general API requests)
  globalRateLimitEnabled    Boolean  @default(true)
  globalRateLimitRequests   Int      @default(100)
  globalRateLimitWindow     Int      @default(60)
  // Login/Sensitive Endpoint Rate Limiting
  loginRateLimitEnabled     Boolean  @default(true)
  loginRateLimitRequests    Int      @default(5)
  loginRateLimitWindow      Int      @default(300)
  // Password Reset Rate Limiting
  passwordResetRateLimitRequests  Int  @default(3)
  passwordResetRateLimitWindow    Int  @default(900)
  // Legacy fields (kept for backwards compatibility)
  ipRateLimitEnabled    Boolean  @default(true)
  ipRateLimitRequests   Int      @default(100)
  ipRateLimitWindow     Int      @default(60)
  csrfProtection        Boolean  @default(true)
  contentSecurityPolicy Boolean  @default(true)

  // reCAPTCHA Bot Protection
  recaptchaEnabled      Boolean  @default(false)
  recaptchaSiteKey      String?
  recaptchaSecretKey    String?

  // Google Analytics / Tag Manager
  gaEnabled             Boolean  @default(false)
  googleAnalyticsId     String?  // GA4 Measurement ID (G-XXXXXXXXXX)
  gtmEnabled            Boolean  @default(false)
  googleTagManagerId    String?  // GTM Container ID (GTM-XXXXXXX)

  // Theme Settings
  primaryColor          String   @default("#0066FF")
  secondaryColor        String   @default("#6366F1")
  accentColor           String   @default("#F59E0B")
  backgroundColor       String   @default("#FFFFFF")
  textColor             String   @default("#1F2937")
  fontFamily            String   @default("Inter")
  borderRadius          String   @default("8")

  // Klipy GIF Settings (powers GIF picker in chat)
  klipyEnabled          Boolean  @default(false)
  klipyApiKey           String?

  // Cloudflare R2 Storage Settings
  r2Enabled             Boolean  @default(false)
  r2AccountId           String?
  r2AccessKeyId         String?
  r2SecretAccessKey     String?
  r2BucketName          String?
  r2PublicDomain        String?
  r2Region              String   @default("auto")
  maxFileSizeMB         Int      @default(50)
  maxProjectStorageMB   Int      @default(200)
  allowedFileTypes      String   @default("pdf,epub,zip,mp3")
  digitalDownloadsEnabled Boolean @default(false)
  signedUrlExpirationMinutes Int @default(60)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ============================================
// BOT PROTECTION & IP BLOCKING
// ============================================

model BlockedIP {
  id            String   @id @default(cuid())
  ipAddress     String   @unique
  reason        String
  violationCount Int     @default(1)
  blockedAt     DateTime @default(now())
  expiresAt     DateTime

  // Metadata for debugging
  lastUserAgent String?
  lastPath      String?
  lastActionId  String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ipAddress])
  @@index([expiresAt])
}

model SuspiciousActivity {
  id            String   @id @default(cuid())
  ipAddress     String
  reason        String
  actionId      String?
  path          String?
  userAgent     String?

  createdAt     DateTime @default(now())

  @@index([ipAddress])
  @@index([createdAt])
}

// ============================================
// MODERATION & REPORTS
// ============================================

model Report {
  id            String       @id @default(cuid())
  reporterId    String?
  reporterEmail String?

  // What is being reported
  targetType    ReportTarget
  targetId      String
  projectId     String?
  userId        String?

  // Report details
  reason        ReportReason
  description   String       @db.Text
  evidence      String[]

  // Status
  status        ReportStatus @default(PENDING)
  priority      ReportPriority @default(MEDIUM)

  // Resolution
  resolvedBy    String?
  resolvedAt    DateTime?
  resolution    String?      @db.Text
  actionTaken   ReportAction?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, priority])
  @@index([targetType, targetId])
  @@index([projectId])
  @@index([userId])
}

enum ReportTarget {
  PROJECT
  USER
  COMMENT
  MESSAGE
  UPDATE
  REWARD
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  FRAUD
  COPYRIGHT
  INAPPROPRIATE_CONTENT
  MISLEADING
  IMPERSONATION
  OTHER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
  ESCALATED
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ReportAction {
  WARNING_ISSUED
  CONTENT_REMOVED
  USER_SUSPENDED
  USER_BANNED
  PROJECT_SUSPENDED
  PROJECT_REMOVED
  NO_ACTION
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id          String             @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  message     String
  read        Boolean            @default(false)
  actionUrl   String?

  // Related entities (optional)
  projectId   String?
  senderId    String?            // For collaborator invites, this would be the project creator

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime           @default(now())
  readAt      DateTime?

  @@index([userId, read])
  @@index([userId, createdAt])
}

enum NotificationType {
  COLLABORATOR_INVITE
  COLLABORATOR_ACCEPTED
  COLLABORATOR_DECLINED
  PROJECT_UPDATE
  PROJECT_FUNDED
  PROJECT_LAUNCHED
  PROJECT_ENDED
  PLEDGE_RECEIVED
  PLEDGE_FAILED
  PLEDGE_SHIPPED
  PLEDGE_DELIVERED
  COMMENT_REPLY
  COMMENT_NEW
  MESSAGE_RECEIVED
  SURVEY_SENT
  SURVEY_REMINDER
  SURVEY_UPDATE_REQUESTED
  FOLLOWED_PROJECT_LAUNCHED
  MARKETPLACE_BOOK_APPROVED
  MARKETPLACE_BOOK_REJECTED
  MARKETPLACE_PURCHASE
  MARKETPLACE_SALE
  PLEDGE_CANCELLED
  PLEDGE_REFUNDED
  PLEDGE_MODIFIED
  PLEDGE_REFUND_DECISION
  CHAT_MESSAGE
  SYSTEM
}

// ============================================
// BUG REPORTS
// ============================================

model BugReport {
  id            String           @id @default(cuid())

  // Reporter info
  userId        String?          // Optional - can be anonymous
  name          String?
  email         String

  // Bug details
  title         String
  description   String           @db.Text
  category      BugCategory      @default(OTHER)
  severity      BugSeverity      @default(MEDIUM)
  pageUrl       String?          // URL where bug occurred
  browser       String?          // Browser info
  device        String?          // Device info
  steps         String?          @db.Text // Steps to reproduce
  expectedBehavior String?       @db.Text
  actualBehavior   String?       @db.Text
  screenshot    String?          // URL to screenshot

  // Status tracking
  status        BugStatus        @default(NEW)
  priority      BugPriority      @default(MEDIUM)
  assignedTo    String?          // Admin user ID
  resolution    String?          @db.Text

  // Timestamps
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  resolvedAt    DateTime?

  // Relations
  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([userId])
}

enum BugCategory {
  UI_VISUAL
  FUNCTIONALITY
  PERFORMANCE
  SECURITY
  PAYMENT
  ACCOUNT
  PROJECT
  REWARDS
  OTHER
}

enum BugSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BugStatus {
  NEW
  ACKNOWLEDGED
  IN_PROGRESS
  NEEDS_INFO
  RESOLVED
  CLOSED
  WONT_FIX
}

enum BugPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ============================================
// MEDIA LIBRARY
// ============================================

model MediaFile {
  id            String     @id @default(cuid())
  uploaderId    String?
  uploader      User?      @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  filename      String
  originalName  String
  mimeType      String
  size          Int
  url           String
  thumbnailUrl  String?

  // Metadata
  width         Int?
  height        Int?
  duration      Int?

  // Organization
  folder        String     @default("uploads")
  tags          String[]
  altText       String?

  // Usage tracking
  usageCount    Int        @default(0)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([uploaderId])
  @@index([folder])
  @@index([mimeType])
}

// ============================================
// PAGE BUILDER
// ============================================

model CustomPage {
  id            String     @id @default(cuid())
  slug          String     @unique
  title         String
  description   String?

  // Page content (JSON structure)
  content       Json

  // SEO
  metaTitle     String?
  metaDescription String?
  ogImage       String?

  // Status
  isPublished   Boolean    @default(false)
  publishedAt   DateTime?

  createdBy     String?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([slug])
  @@index([isPublished])
}

// ============================================
// API KEYS
// ============================================

model ApiKey {
  id            String        @id @default(cuid())

  // Key details
  name          String        // Display name for the key
  key           String        @unique // The actual API key (hashed prefix for display)
  keyHash       String        // Hashed version of the full key for verification
  prefix        String        // First 8 chars for identification (e.g., "sk_live_")

  // Environment
  environment   ApiEnvironment @default(PRODUCTION)

  // Status
  status        ApiKeyStatus  @default(ACTIVE)

  // Usage tracking
  lastUsedAt    DateTime?
  usageCount    Int           @default(0)

  // Timestamps
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  expiresAt     DateTime?     // Optional expiration
  revokedAt     DateTime?

  // Created by admin
  createdById   String?
  createdBy     User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([key])
  @@index([prefix])
  @@index([status])
  @@index([createdById])
}

enum ApiEnvironment {
  PRODUCTION
  DEVELOPMENT
  STAGING
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

// ============================================
// ID VERIFICATION
// ============================================

model IDVerification {
  id                String                 @id @default(cuid())
  userId            String

  // Shufti Reference
  shuftiReference   String                 @unique
  verificationUrl   String?

  // Verification Status
  status            IDVerificationStatus   @default(PENDING)

  // Results
  isDocumentValid   Boolean?
  isFaceMatch       Boolean?
  isAgeVerified     Boolean?
  detectedAge       Int?
  documentType      String?
  documentCountry   String?

  // Decline info
  declineReason     String?
  declineCodes      String[]

  // Raw response (for debugging)
  rawResponse       Json?

  // Timestamps
  requestedAt       DateTime              @default(now())
  completedAt       DateTime?
  expiresAt         DateTime?

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([shuftiReference])
  @@index([status])
}

enum IDVerificationStatus {
  PENDING
  PROCESSING
  VERIFIED
  DECLINED
  EXPIRED
  CANCELLED
}

// ============================================
// FEATURE FLAGS
// ============================================

model FeatureFlag {
  id          String   @id @default(cuid())
  name        String   @unique
  enabled     Boolean  @default(false)
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

// ============================================
// GDPR DATA EXPORT REQUESTS
// ============================================

model DataExportRequest {
  id          String              @id @default(cuid())
  userId      String
  status      DataExportStatus    @default(PENDING)
  format      String              @default("json") // "json" or "csv"
  downloadUrl String?             // Signed URL to download the export
  expiresAt   DateTime?           // When the download link expires
  completedAt DateTime?
  error       String?

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId])
  @@index([status])
}

enum DataExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

// ============================================
// GDPR DELETION REQUESTS (Right to be Forgotten)
// ============================================

model DataDeletionRequest {
  id              String                @id @default(cuid())
  userId          String
  userEmail       String                // Preserved for audit even after user deletion
  status          DataDeletionStatus    @default(PENDING)
  reason          String?
  scheduledFor    DateTime              // When the deletion will be executed (grace period)
  executedAt      DateTime?
  cancelledAt     DateTime?
  auditLog        Json?                 // Summary of what was deleted

  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([userId])
  @@index([status])
  @@index([scheduledFor])
}

enum DataDeletionStatus {
  PENDING
  SCHEDULED
  EXECUTING
  COMPLETED
  CANCELLED
}

// ============================================
// CCPA OPT-OUT RECORDS
// ============================================

model CcpaOptOut {
  id          String   @id @default(cuid())
  userId      String?  // Null for anonymous opt-outs
  email       String?  // For verification
  ipAddress   String?  // For anonymous opt-outs
  optOutType  String   @default("analytics") // "analytics", "sale", "all"
  optedOutAt  DateTime @default(now())
  reinstatedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([email])
  @@index([ipAddress])
}
