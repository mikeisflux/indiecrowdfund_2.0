// ============================================
// PAYMENT PROCESSOR CONFIGURATION
// ============================================

model StripeConfig {
  id              String   @id @default(cuid())
  userId          String   @unique
  stripeAccountId String   @unique
  isOnboarded     Boolean  @default(false)
  isActive        Boolean  @default(true)

  user            User     @relation(fields: [userId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

// Creator chargeback protection card (AES-256 encrypted, per-project)
model CreatorChargebackCard {
  id                    String   @id @default(cuid())
  projectId             String   @unique

  // Encrypted card details (AES-256 encrypted)
  cardNumberEncrypted   String   @db.Text
  expMonthEncrypted     String   @db.Text
  expYearEncrypted      String   @db.Text
  cvcEncrypted          String   @db.Text

  // Encrypted billing address
  billingNameEncrypted  String   @db.Text
  billingLine1Encrypted String   @db.Text
  billingLine2Encrypted String?  @db.Text
  billingCityEncrypted  String   @db.Text
  billingStateEncrypted String   @db.Text
  billingZipEncrypted   String   @db.Text
  billingCountryEncrypted String @db.Text

  // Non-sensitive display data
  cardLastFour          String   // e.g., "4242"
  cardBrand             String?  // e.g., "Visa", "Mastercard"
  expMonth              Int
  expYear               Int

  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([projectId])
}

// DivinityCoin bank account for creator payouts
model DivinityCoinBankAccount {
  id                    String   @id @default(cuid())
  userId                String   @unique

  // Encrypted bank details (AES-256 encrypted)
  bankNameEncrypted     String   @db.Text
  accountHolderEncrypted String  @db.Text
  accountNumberEncrypted String  @db.Text
  routingNumberEncrypted String  @db.Text

  // Non-sensitive display data
  bankNameDisplay       String?  // e.g., "Chase Bank"
  accountLastFour       String?  // e.g., "4567"
  accountType           String   @default("checking") // checking or savings

  // Verification status
  isVerified            Boolean  @default(false)
  verifiedAt            DateTime?
  verificationMethod    String?  // e.g., "micro_deposits", "instant"

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  settlements           DivinityCoinSettlement[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
}

// PayPal bank account for creator payouts (separate from DivinityCoin)
model PayPalBankAccount {
  id                    String   @id @default(cuid())
  userId                String   @unique

  // Encrypted bank details (AES-256 encrypted)
  bankNameEncrypted     String   @db.Text
  accountHolderEncrypted String  @db.Text
  accountNumberEncrypted String  @db.Text
  routingNumberEncrypted String  @db.Text

  // Non-sensitive display data
  bankNameDisplay       String?  // e.g., "Chase Bank"
  accountLastFour       String?  // e.g., "4567"
  accountType           String   @default("checking") // checking or savings

  // Verification status
  isVerified            Boolean  @default(false)
  verifiedAt            DateTime?
  verificationMethod    String?  // e.g., "micro_deposits", "instant"

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts               PayPalPayout[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
}

// PayPal payout config per creator (their PayPal email for receiving payouts)
model PayPalPayoutConfig {
  id              String   @id @default(cuid())
  userId          String   @unique
  paypalEmail     String   // Creator's PayPal email to receive payouts
  isVerified      Boolean  @default(false)
  verifiedAt      DateTime?

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts         PayPalPayout[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

// PayPal payout settlement record (per project/per creator)
model PayPalPayout {
  id                  String   @id @default(cuid())
  payoutConfigId      String?  // Legacy: PayPal email payout config (nullable for bank account payouts)
  paypalBankAccountId String?  // Creator's bank account for direct deposit payouts
  projectId           String?
  projectName         String?  // Denormalized

  // Payout details
  grossAmount     Decimal  @db.Decimal(10, 2)  // Total collected
  platformFee     Decimal  @db.Decimal(10, 2)  // Platform's 3%
  netAmount       Decimal  @db.Decimal(10, 2)  // What creator receives
  currency        String   @default("USD")

  // PayPal tracking (for PayPal-initiated payouts)
  paypalBatchId   String?  // PayPal payout batch ID
  paypalItemId    String?  // Individual item ID within batch
  status          PayPalPayoutStatus @default(PENDING)

  // Processing
  initiatedAt     DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  adminNotes      String?  @db.Text
  processedBy     String?

  payoutConfig        PayPalPayoutConfig?  @relation(fields: [payoutConfigId], references: [id])
  paypalBankAccount   PayPalBankAccount?   @relation(fields: [paypalBankAccountId], references: [id])
  project             Project?             @relation(fields: [projectId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([payoutConfigId])
  @@index([paypalBankAccountId])
  @@index([projectId])
  @@index([status])
}

enum PayPalPayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// DivinityCoin settlement tracking for admin payouts
model DivinityCoinSettlement {
  id                    String   @id @default(cuid())
  bankAccountId         String

  // Settlement details
  amount                Decimal  @db.Decimal(10, 2) // Amount in USD
  currency              String   @default("USD")
  status                DivinityCoinSettlementStatus @default(PENDING)

  // Project reference (optional - for project-specific settlements)
  projectId             String?
  projectName           String?  // Denormalized for history

  // DivinityCoin reference
  divinitySettlementId  String?  @unique // External settlement ID from DivinityCoin
  divinityBatchId       String?  // Batch ID if part of a batch settlement

  // Processing details
  initiatedAt           DateTime?
  processedAt           DateTime?
  completedAt           DateTime?
  failedAt              DateTime?
  failureReason         String?

  // Admin notes
  adminNotes            String?  @db.Text
  processedBy           String?  // Admin user ID who processed it

  bankAccount           DivinityCoinBankAccount @relation(fields: [bankAccountId], references: [id])
  project               Project? @relation(fields: [projectId], references: [id])

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([bankAccountId])
  @@index([projectId])
  @@index([status])
  @@index([createdAt])
}

enum DivinityCoinSettlementStatus {
  PENDING     // Awaiting processing
  INITIATED   // Wire transfer initiated
  PROCESSING  // In progress
  COMPLETED   // Successfully delivered
  FAILED      // Failed to process
  CANCELLED   // Cancelled by admin
}

// DivinityCoin credit redemption tracking
model DivinityCoinRedemption {
  id              String   @id @default(cuid())
  code            String   @unique // The redemption code
  userId          String
  amount          Decimal  @db.Decimal(10, 2) // Amount in USD
  redeemedAt      DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
}

// DivinityCoin transaction history with audit logging
model DivinityCoinTransaction {
  id              String   @id @default(cuid())
  userId          String
  pledgeId        String?
  amount          Decimal  @db.Decimal(10, 2) // Positive for credits, negative for payments
  type            String   // REDEMPTION, PAYMENT, REFUND, REFUND_DEDUCTION
  description     String?
  metadata        String?  @db.Text // JSON audit data: requestId, IP, previous/new balance, timestamps

  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pledge          Pledge?  @relation(fields: [pledgeId], references: [id])

  @@index([userId])
  @@index([pledgeId])
  @@index([createdAt])
}
