// ============================================
// REWARDS & ADD-ONS
// ============================================

model Reward {
  id                String       @id @default(cuid())
  projectId         String
  type              RewardType   @default(TIER)

  title             String
  description       String       @db.Text
  amount            Decimal      @db.Decimal(10, 2)
  imageUrl          String?

  // Creator-chosen grouping label ("Covers", "Box Sets", "Upgrades"), used to
  // build the filter pills above the reward grid on layout-v2 campaign pages.
  // Free text rather than an enum: every campaign carves its catalogue up
  // differently, and an enum would need a migration per creator idea.
  // Null / empty = uncategorised, which the campaign page groups under
  // "Other" so nothing becomes unreachable behind a filter.
  category          String?

  // Delivery
  estimatedDelivery DateTime?
  shippingType      ShippingType
  shippingCountries String[]
  shippingCost      Json         @default("{}")  // Per-country rates: { "US": 5, "CA": 8 }

  // Availability
  quantityAvailable Int?
  quantityClaimed   Int          @default(0)
  visibility        Visibility   @default(PUBLIC)
  secretToken       String?      @unique  // For secret rewards - only accessible via this token
  availableFrom     DateTime?
  availableUntil    DateTime?

  // Status - for ending rewards that have backers
  isEnded           Boolean      @default(false)
  endedAt           DateTime?

  // Modifier addon settings (for ADDON type rewards that modify base rewards)
  isModifier        Boolean      @default(false)  // True if this addon modifies a base reward instead of being standalone
  modifiesRewardIds String[]                      // Which reward IDs this can modify (empty = all tiers in project)

  // Survey integration - whether this addon appears in the IndieKit survey
  showInSurvey      Boolean      @default(false)

  // Creator-chosen display order for reward tiers / add-ons. Null = not
  // manually ordered → fall back to price (amount asc). Ordered within each
  // type (TIER / ADDON) since those render as separate lists.
  displayOrder      Int?

  // Shared stock. When an add-on is the same physical thing as a tier (or as
  // another add-on), point it at that reward and the two draw from ONE pool:
  // the target's quantityAvailable is the cap, and claims from either side
  // count against it. "LTD to 10" with 4 tiers and 6 add-ons sold = sold out.
  // Null means this reward keeps its own independent count.
  sharedStockWithId String?

  // Tracking if copied
  copiedFromId      String?

  // Relations
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pledges           Pledge[]
  items             RewardItem[]
  copiedFrom        Reward?      @relation("RewardCopies", fields: [copiedFromId], references: [id])
  copies            Reward[]     @relation("RewardCopies")
  sharedStockWith   Reward?      @relation("SharedStock", fields: [sharedStockWithId], references: [id])
  sharedStockPeers  Reward[]     @relation("SharedStock")
  selectedAddons    PledgeAddon[]

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([projectId, type])
  // Category lookups (the builder's "categories already used here" datalist).
  // Created by migrations/add_reward_category.sql — declared here so the
  // schema matches the database and `migrate diff` doesn't propose dropping it.
  @@index([projectId, category])
  // Shared-stock pool lookups walk this both ways. Created by
  // migrations/add_reward_shared_stock.sql — declared here so the schema
  // matches the database and `migrate diff` doesn't propose dropping it.
  @@index([sharedStockWithId])
}

enum RewardType {
  TIER
  ADDON
}

enum ShippingType {
  WORLDWIDE
  SELECTED_COUNTRIES
  NO_SHIPPING
}

enum Visibility {
  PUBLIC
  SECRET
}

model RewardItem {
  id            String  @id @default(cuid())
  rewardId      String
  projectItemId String?  // Optional reference to project-level item
  title         String
  description   String? @db.Text
  imageUrl      String?

  reward        Reward       @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  projectItem   ProjectItem? @relation(fields: [projectItemId], references: [id])

  @@index([rewardId])
  @@index([projectItemId])
}
