// ============================================
// RETAILER / LCS SYSTEM
// ============================================

model Retailer {
  id     String  @id @default(cuid())
  userId String? @unique

  // Business Information
  businessName String
  businessType RetailerType
  contactName  String
  email        String       @unique
  phone        String

  // Address
  address String
  city    String
  state   String
  zipCode String
  country String @default("US")

  // Tax Information
  taxId             String
  taxIdType         TaxIdType @default(EIN)
  resaleCertificate String?

  // Business Details
  yearsInBusiness   Int?
  numberOfLocations Int     @default(1)
  annualRevenue     String?
  websiteUrl        String?
  socialMedia       Json?

  // Verification
  status            RetailerStatus @default(PENDING)
  verificationNotes String?        @db.Text
  verifiedAt        DateTime?
  verifiedBy        String?

  // Access
  accessCode   String?   @unique
  passwordHash String?
  lastLoginAt  DateTime?

  // Relations
  pledges             RetailerPledge[]
  satisfactionSurveys RetailerSatisfactionSurvey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([accessCode])
}

model RetailerPledge {
  id         String @id @default(cuid())
  retailerId String
  projectId  String
  rewardId   String

  // Order Details
  quantity        Int
  unitPrice       Decimal @db.Decimal(10, 2)
  discountPercent Float
  totalAmount     Decimal @db.Decimal(10, 2)
  originalAmount  Decimal @db.Decimal(10, 2)

  // Payment
  status           RetailerPledgeStatus @default(PENDING)
  paymentMethod    String?
  paymentReference String?
  invoiceNumber    String?              @unique

  // Shipping
  shippingAddress Json?
  shippingMethod  String?
  shippingCost    Decimal @default(0) @db.Decimal(10, 2)
  trackingNumber  String?

  // Fulfillment
  fulfillmentStatus FulfillmentStatus @default(NOT_STARTED)
  fulfillmentNotes  String?           @db.Text

  // PO Information
  purchaseOrderNumber String?

  // Relations
  retailer Retailer @relation(fields: [retailerId], references: [id])
  project  Project  @relation(fields: [projectId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?

  @@index([retailerId])
  @@index([projectId])
  @@index([status])
}

enum RetailerType {
  COMIC_SHOP
  BOOKSTORE
  GAME_STORE
  HOBBY_SHOP
  ONLINE_RETAILER
  DISTRIBUTOR
  OTHER
}

enum TaxIdType {
  EIN
  SSN
  VAT
  OTHER
}

enum RetailerStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum RetailerPledgeStatus {
  PENDING
  INVOICED
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

// Retailer Satisfaction Survey - sent after marking shipment received
model RetailerSatisfactionSurvey {
  id               String @id @default(cuid())
  retailerId       String
  retailerPledgeId String @unique

  // Rating (1-5 stars)
  rating Int?

  // Feedback
  feedback String? @db.Text

  // Categories
  productQuality    Int? // 1-5 rating
  shippingSpeed     Int? // 1-5 rating
  packaging         Int? // 1-5 rating
  communication     Int? // 1-5 rating
  overallExperience Int? // 1-5 rating

  // Would recommend?
  wouldRecommend Boolean?

  // Status
  sentAt      DateTime?
  completedAt DateTime?

  // Relations
  retailer Retailer @relation(fields: [retailerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([retailerId])
  @@index([completedAt])
  @@index([rating])
}
