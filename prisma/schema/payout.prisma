// ============================================
// PAYOUTS
// ============================================

model Payout {
  id                String       @id @default(cuid())
  projectId         String
  amount            Decimal      @db.Decimal(10, 2)
  grossAmount       Decimal      @db.Decimal(10, 2)
  processorFees     Decimal      @db.Decimal(10, 2)
  platformFees      Decimal      @db.Decimal(10, 2)
  type              PayoutType
  status            PayoutStatus
  payoutId          String?      @unique
  bankAccountLast4  String?

  project           Project      @relation(fields: [projectId], references: [id])

  sentAt            DateTime?
  createdAt         DateTime     @default(now())
  deletedAt         DateTime?    // Soft delete timestamp

  @@index([projectId])
  @@index([deletedAt])  // For soft delete filtering
}

enum PayoutType {
  CAMPAIGN
  LATE_PLEDGE
  PLEDGE_MANAGER
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================
// Grant Program
// ============================================
// A creator's signed acceptance of the Divinity Comics Grant Program
// agreement for a specific project. Funds are disbursed to creators as
// grants; a payout cannot be created for a project without a signed
// agreement. `version` records which revision of the agreement text was
// accepted (see GRANT_AGREEMENT_VERSION in the legal component).
model GrantAgreement {
  id         String   @id @default(cuid())
  userId     String
  projectId  String   @unique
  version    String
  acceptedAt DateTime @default(now())

  // Grantee tax information, collected at signing time (prefilled from the
  // campaign-creation data where available). The TIN is AES-256 encrypted at
  // rest like bank/card data; only the last 4 digits are stored in the clear
  // for admin display.
  taxLegalName    String?
  taxBusinessName String?
  taxEntityType   String?  // INDIVIDUAL | BUSINESS | NONPROFIT
  taxIdEncrypted  String?  @db.Text
  taxIdLast4      String?
  taxAddressLine1 String?
  taxAddressLine2 String?
  taxCity         String?
  taxState        String?
  taxZip          String?
  taxCountry      String?

  user    User    @relation("GrantAgreements", fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A creator's acceptance of a specific version of the Terms of Service.
//
// One row per (user, version) rather than a single "acceptedVersion" column on
// User: section 16 of the Terms promises we can say which version applied to a
// given campaign or pledge, and that needs the history, not just the latest
// answer. IP and user agent are captured because an acceptance nobody can
// evidence is worth little in a dispute.
model TermsAcceptance {
  id         String   @id @default(cuid())
  userId     String
  version    String
  acceptedAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?  @db.Text

  user User @relation("TermsAcceptances", fields: [userId], references: [id], onDelete: Cascade)

  // Re-accepting the same version is a no-op rather than a duplicate row.
  @@unique([userId, version])
  @@index([userId])
}
